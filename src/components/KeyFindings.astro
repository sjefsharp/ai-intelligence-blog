---
/**
 * KeyFindings — TL;DR / Key Takeaways component for ADHD-friendly reading.
 * Presents the most critical information upfront (BLUF pattern).
 */
import { getTranslation, type Locale } from "../i18n";
import type { TranslationKeys } from "../i18n";

interface Props {
	locale: Locale;
	t: TranslationKeys;
	findings: string[];
	title?: string;
}

const { locale, t, findings, title } = Astro.props;
const displayTitle = title || t.ui.keyFindings || "Key Findings";
---

{findings && findings.length > 0 && (
	<aside
		class="key-findings"
		role="region"
		aria-labelledby="key-findings-title"
	>
		<h2 id="key-findings-title" class="key-findings-title">
			<span class="key-findings-icon" aria-hidden="true">
				🎯
			</span>
			{displayTitle}
		</h2>
		<ol class="key-findings-list">
			{findings.map((finding, i) => (
				<li class="key-finding-item" style={`--item-index: ${i + 1};`}>
					<span class="key-finding-marker" aria-hidden="true">
						{i + 1}
					</span>
					<p>{finding}</p>
				</li>
			))}
		</ol>
	</aside>
)}

<style>
	.key-findings {
		background: var(--valley-light);
		border: 1px solid var(--valley);
		border-radius: var(--radius);
		padding: var(--space-4) var(--space-5);
		margin: var(--space-5) 0;
		border-left: 4px solid var(--gold);
	}

	.key-findings-title {
		font-family: var(--font-structural);
		font-size: var(--size-sm);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--gold);
		margin: 0 0 var(--space-3);
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}

	.key-findings-icon {
		font-size: var(--size-base);
	}

	.key-findings-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.key-finding-item {
		position: relative;
		padding-left: var(--space-8);
		line-height: var(--leading-relaxed);
	}

	.key-finding-marker {
		position: absolute;
		left: 0;
		top: 0;
		width: var(--space-5);
		height: var(--space-5);
		background: var(--gold);
		color: var(--ink);
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-structural);
		font-size: var(--size-xs);
		font-weight: 700;
		flex-shrink: 0;
	}

	.key-finding-item p {
		margin: 0;
		font-size: var(--size-sm);
		line-height: var(--leading-relaxed);
	}

	/* Reduced motion */
	@media (prefers-reduced-motion: reduce) {
		.key-findings {
			transition: none;
		}
	}

	/* High contrast */
	@media (prefers-contrast: high) {
		.key-findings {
			border-color: currentColor;
			background: transparent;
		}
		.key-finding-marker {
			border: 2px solid currentColor;
		}
	}

	/* Print */
	@media print {
		.key-findings {
			break-inside: avoid;
			border-color: #000;
			background: #f9f9f9;
		}
	}
</style>
