---
/**
 * Visualization.astro
 *
 * Renders an evidence-based visualization from a visualization specification.
 * Supports all visualization types with accessible fallbacks and bilingual support.
 */

import type {
	VisualizationSpecification,
	VisualizationLanguage,
} from "../lib/visualization/schema.js";
import { renderVisualization } from "../lib/visualization/render.js";

interface Props {
	/** The visualization specification to render */
	spec: VisualizationSpecification;
	/** Current locale (nl or en) */
	locale: "nl" | "en";
	/** Optional: override the render status for display */
	renderStatus?:
		"READY" | "RENDERED" | "VALIDATED" | "FAILED" | "UNAVAILABLE";
}

const { spec, locale, renderStatus } = Astro.props;

// Get the appropriate language variant
const variant =
	spec.languageVariants.find((v) => v.language === locale) ||
	spec.languageVariants[0];

// Render the visualization HTML
const visualizationHtml = renderVisualization(spec, locale);

// Determine status display
const status = renderStatus || spec.status.renderStatus;
const statusLabels: Record<string, { nl: string; en: string }> = {
	READY: { nl: "Klaar voor渲染", en: "Ready to render" },
	RENDERED: { nl: "Gerenderd", en: "Rendered" },
	VALIDATED: { nl: "Gevalideerd", en: "Validated" },
	FAILED: { nl: "Mislukt", en: "Failed" },
	UNAVAILABLE: { nl: "Niet beschikbaar", en: "Unavailable" },
};

const statusLabel = statusLabels[status]?.[locale] || status;
const isValidated = status === "VALIDATED";
const isFailed = status === "FAILED";
const isUnavailable = status === "UNAVAILABLE";
---

<!--
  Visualization Component
  Renders evidence-based visual explanations with full accessibility support.
  Visualizations are optional — their absence never blocks publication.
-->
<figure
	class="visualization-container"
	data-viz-id={spec.visualizationId}
	data-viz-type={spec.type}
	data-viz-status={status}
	data-viz-locale={locale}
>
	<figcaption class="visualization-figcaption">
		<div class="visualization-header">
			<h3 class="visualization-title">{variant.title}</h3>
			<span class="visualization-status" data-status={status}>
				{statusLabel}
			</span>
		</div>
		<p class="visualization-caption">{variant.caption}</p>
		{spec.explanatoryPurpose && (
			<p class="visualization-purpose">
				<em>{locale === "nl" ? "Doel: " : "Purpose: "}</em>
				{spec.explanatoryPurpose}
			</p>
		)}
	</figcaption>

	<!-- Primary visualization output -->
	<div class="visualization-primary" role="region" aria-label={variant.title}>
		{isUnavailable ? (
			<div class="visualization-unavailable">
				<p>
					{locale === "nl"
						? "Deze visualisatie is niet beschikbaar."
						: "This visualization is unavailable."}
				</p>
				<p class="visualization-fallback-notice">
					{variant.longDescription}
				</p>
			</div>
		) : isFailed ? (
			<div class="visualization-failed">
				<p>
					{locale === "nl"
						? "Deze visualisatie kon niet worden gerenderd."
						: "This visualization could not be rendered."}
				</p>
				<details class="visualization-fallback" open>
					<summary>
						{locale === "nl"
							? "Tekstuele weergave"
							: "Textual representation"}
					</summary>
					<div class="visualization-long-description">
						{variant.longDescription}
					</div>
				</details>
			</div>
		) : (
			<Fragment set:html={visualizationHtml} />
		)}
	</div>

	<!-- Accessibility metadata (hidden, for screenreaders and validation) -->
	<details class="visualization-metadata" hidden>
		<summary>Visualization Metadata</summary>
		<dl>
			<dt>Visualization ID</dt>
			<dd>{spec.visualizationId}</dd>
			<dt>Type</dt>
			<dd>{spec.type}</dd>
			<dt>Edition</dt>
			<dd>{spec.editionId}</dd>
			<dt>Article</dt>
			<dd>{spec.articleId || "N/A"}</dd>
			<dt>Candidates</dt>
			<dd>{spec.candidateIds.join(", ")}</dd>
			<dt>Claims</dt>
			<dd>{spec.claimIds.join(", ")}</dd>
			<dt>Sources</dt>
			<dd>{spec.sourceIds.join(", ")}</dd>
			<dt>Schema Version</dt>
			<dd>{spec.schemaVersion}</dd>
			<dt>Content Hash</dt>
			<dd>{spec.status.contentHash}</dd>
			<dt>Render Status</dt>
			<dd>{status}</dd>
			<dt>Validated</dt>
			<dd>{spec.status.validated ? "Yes" : "No"}</dd>
			<dt>Generated At</dt>
			<dd>{spec.status.generatedAt}</dd>
			<dt>Generated By</dt>
			<dd>{spec.status.generatedBy}</dd>
		</dl>
	</details>

	<!-- Uncertainty and limitations disclosure -->
	{spec.uncertainty.assumptions.length > 0 ||
		(spec.uncertainty.limitations.length > 0 && (
			<details class="visualization-uncertainty">
				<summary>
					{locale === "nl"
						? "Onzekerheden en beperkingen"
						: "Uncertainties and limitations"}
				</summary>
				<ul>
					{spec.uncertainty.assumptions.map((a) => (
						<li>
							<strong>
								{locale === "nl" ? "Aanname: " : "Assumption: "}
							</strong>
							{a}
						</li>
					))}
					{spec.uncertainty.limitations.map((l) => (
						<li>
							<strong>
								{locale === "nl"
									? "Beperking: "
									: "Limitation: "}
							</strong>
							{l}
						</li>
					))}
					{spec.uncertainty.unsupportedInferences.map((i) => (
						<li>
							<strong>
								{locale === "nl"
									? "Niet-ondersteunde inferentie: "
									: "Unsupported inference: "}
							</strong>
							{i}
						</li>
					))}
					{spec.uncertainty.evidenceGaps.map((g) => (
						<li>
							<strong>
								{locale === "nl"
									? "Bewijsgat: "
									: "Evidence gap: "}
							</strong>
							{g}
						</li>
					))}
				</ul>
				{spec.uncertainty.causalityRisk && (
					<p class="uncertainty-warning">
						⚠{" "}
						{locale === "nl"
							? "Deze visualisatie kan causaliteit impliceren die niet door bewijs wordt ondersteund."
							: "This visualization may imply causality not supported by evidence."}
					</p>
				)}
				{spec.uncertainty.colorOnlyRisk && (
					<p class="uncertainty-warning">
						⚠{" "}
						{locale === "nl"
							? "Deze visualisatie gebruikt kleur als enig informatiekanaal."
							: "This visualization uses color as the sole information channel."}
					</p>
				)}
				{spec.uncertainty.boundarySimplificationRisk && (
					<p class="uncertainty-warning">
						⚠{" "}
						{locale === "nl"
							? "Kritieke vertrouwensgrenzen kunnen in deze visualisatie oversimpel zijn weergegeven."
							: "Critical trust boundaries may be oversimplified in this visualization."}
					</p>
				)}
			</details>
		))}

	<!-- Source attribution -->
	<details class="visualization-sources">
		<summary>
			{locale === "nl" ? "Bronverwijzingen" : "Source references"}
		</summary>
		<ul>
			{spec.sourceIds.map((sourceId) => (
				<li>{sourceId}</li>
			))}
		</ul>
	</details>
</figure>

<style>
	.visualization-container {
		margin: var(--space-6) calc(var(--margin-page) * -1);
		padding: var(--space-4) var(--margin-page);
		border: 1px solid var(--mountain-light);
		border-radius: var(--radius);
		background: var(--sheet);
		overflow-x: auto;
	}

	.visualization-figcaption {
		margin-bottom: var(--space-4);
	}

	.visualization-header {
		display: flex;
		align-items: baseline;
		gap: var(--space-3);
		flex-wrap: wrap;
		margin-bottom: var(--space-2);
	}

	.visualization-title {
		font-family: var(--font-display);
		font-size: var(--size-lg);
		font-weight: 700;
		color: var(--ink);
		margin: 0;
	}

	.visualization-status {
		font-family: var(--font-structural);
		font-size: var(--size-xs);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		padding: 2px 8px;
		border-radius: 999px;
		background: var(--valley-light);
		color: var(--valley);
	}

	.visualization-status[data-status="VALIDATED"] {
		background: var(--gold);
		color: var(--ink);
	}

	.visualization-status[data-status="FAILED"] {
		background: #c0392b;
		color: white;
	}

	.visualization-status[data-status="UNAVAILABLE"] {
		background: var(--mountain-light);
		color: var(--mountain);
	}

	.visualization-caption {
		font-size: var(--size-sm);
		color: var(--ink-muted);
		margin: 0;
		line-height: var(--leading-normal);
	}

	.visualization-purpose {
		font-size: var(--size-xs);
		color: var(--ink-muted);
		margin: var(--space-2) 0 0;
		font-style: italic;
	}

	.visualization-primary {
		min-height: 200px;
	}

	.visualization-unavailable,
	.visualization-failed {
		padding: var(--space-6);
		text-align: center;
		background: var(--sheet-darker);
		border-radius: var(--radius);
		border: 1px dashed var(--mountain-light);
	}

	.visualization-fallback-notice,
	.visualization-long-description {
		font-size: var(--size-sm);
		color: var(--ink-muted);
		margin-top: var(--space-3);
		padding: var(--space-3);
		background: var(--sheet);
		border-radius: var(--radius);
		border-left: 3px solid var(--valley);
		text-align: left;
	}

	.visualization-fallback {
		margin-top: var(--space-4);
		padding: var(--space-4);
		background: var(--sheet-darker);
		border-radius: var(--radius);
		border: 1px solid var(--mountain-light);
	}

	.visualization-fallback summary {
		font-family: var(--font-structural);
		font-size: var(--size-sm);
		font-weight: 600;
		color: var(--gold);
		cursor: pointer;
		padding: var(--space-2);
	}

	.visualization-fallback summary:hover {
		color: var(--gold-dim);
	}

	.visualization-metadata {
		margin-top: var(--space-4);
		padding: var(--space-3);
		background: var(--sheet-darker);
		border-radius: var(--radius);
		font-family: var(--font-structural);
		font-size: var(--size-xs);
	}

	.visualization-metadata summary {
		font-weight: 600;
		color: var(--gold);
		cursor: pointer;
	}

	.visualization-metadata dl {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: var(--space-1) var(--space-3);
		margin: var(--space-2) 0 0;
	}

	.visualization-metadata dt {
		color: var(--ink-muted);
		font-weight: 600;
	}

	.visualization-metadata dd {
		margin: 0;
		color: var(--ink);
		word-break: break-all;
	}

	.visualization-uncertainty {
		margin-top: var(--space-4);
		padding: var(--space-3);
		background: var(--sheet-darker);
		border-radius: var(--radius);
		border-left: 3px solid var(--gold);
	}

	.visualization-uncertainty summary {
		font-family: var(--font-structural);
		font-size: var(--size-sm);
		font-weight: 600;
		color: var(--gold);
		cursor: pointer;
		padding: var(--space-2);
	}

	.visualization-uncertainty ul {
		margin: var(--space-2) 0 0;
		padding-left: var(--space-4);
		font-size: var(--size-sm);
		color: var(--ink-muted);
	}

	.visualization-uncertainty li {
		margin-bottom: var(--space-1);
	}

	.uncertainty-warning {
		margin-top: var(--space-3);
		padding: var(--space-2);
		background: #fff3e0;
		border: 1px solid #ffb74d;
		border-radius: var(--radius);
		font-size: var(--size-xs);
		color: #e65100;
	}

	.visualization-sources {
		margin-top: var(--space-3);
		padding: var(--space-3);
		background: var(--sheet-darker);
		border-radius: var(--radius);
		font-size: var(--size-xs);
		color: var(--ink-muted);
	}

	.visualization-sources summary {
		font-family: var(--font-structural);
		font-weight: 600;
		color: var(--valley);
		cursor: pointer;
	}

	.visualization-sources ul {
		margin: var(--space-2) 0 0;
		padding-left: var(--space-4);
	}

	/* Ensure SVG scales properly */
	.visualization-primary svg {
		max-width: 100%;
		height: auto;
		display: block;
	}

	/* Table fallback styling */
	.visualization-table {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--size-sm);
		font-family: var(--font-reading);
		margin: var(--space-3) 0;
	}

	.visualization-table th,
	.visualization-table td {
		padding: var(--space-2) var(--space-3);
		text-align: left;
		border-bottom: 1px solid var(--mountain-light);
	}

	.visualization-table th {
		font-family: var(--font-structural);
		font-weight: 700;
		font-size: var(--size-xs);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--ink-muted);
		background: var(--sheet-darker);
		border-bottom: 2px solid var(--mountain);
	}

	.visualization-table tr.group-header {
		background: var(--valley-light);
	}

	.visualization-table tr.group-header td {
		font-weight: 700;
		color: var(--valley);
	}

	.visualization-table tr.even td {
		background: var(--sheet);
	}

	.visualization-table tr.odd td {
		background: var(--sheet-darker);
	}

	.visualization-table td.group-header-cell {
		font-weight: 700;
		color: var(--valley);
		background: var(--valley-light);
	}

	/* Concept map text fallback */
	.concept-map-text h3 {
		font-family: var(--font-display);
		font-size: var(--size-lg);
		margin-top: var(--space-4);
		margin-bottom: var(--space-2);
	}

	.concept-map-text dl {
		margin: var(--space-2) 0;
	}

	.concept-map-text dt {
		font-weight: 700;
		color: var(--ink);
	}

	.concept-map-text dd {
		margin: 0 0 var(--space-2) var(--space-4);
		color: var(--ink-muted);
	}

	.concept-category {
		font-family: var(--font-structural);
		font-size: var(--size-xs);
		color: var(--gold);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-left: var(--space-2);
	}

	.concept-map-text ul {
		margin: var(--space-2) 0;
		padding-left: var(--space-4);
	}

	/* Architecture diagram table sections */
	.arch-table-section {
		margin-bottom: var(--space-5);
	}

	.arch-table-section h3 {
		font-family: var(--font-display);
		font-size: var(--size-lg);
		margin-bottom: var(--space-2);
	}

	/* Responsive */
	@media (max-width: 720px) {
		.visualization-container {
			margin-left: calc(var(--margin-page) * -1);
			margin-right: calc(var(--margin-page) * -1);
			padding-left: var(--margin-page);
			padding-right: var(--margin-page);
			border-radius: 0;
			border-left: none;
			border-right: none;
		}

		.visualization-header {
			flex-direction: column;
			align-items: flex-start;
		}
	}

	/* Reduced motion */
	@media (prefers-reduced-motion: reduce) {
		.visualization-primary * {
			animation: none !important;
			transition: none !important;
		}
	}

	/* High contrast mode */
	@media (prefers-contrast: high) {
		.visualization-container {
			border-color: var(--ink);
		}

		.visualization-status {
			border: 1px solid currentColor;
		}
	}

	/* Print */
	@media print {
		.visualization-container {
			break-inside: avoid;
			border: 1px solid #ccc;
		}

		.visualization-status,
		.visualization-metadata,
		.visualization-uncertainty,
		.visualization-sources {
			display: none;
		}

		.visualization-primary svg {
			max-width: 100%;
		}
	}
</style>
