      "properties": {
        "explicitObjectives": {
          "default": false,
          "type": "boolean"
        },
        "explicitPrerequisites": {
          "default": false,
          "type": "boolean"
        },
        "progressiveDisclosure": {
          "default": false,
          "type": "boolean"
        },
        "contextBeforeComplexity": {
          "default": false,
