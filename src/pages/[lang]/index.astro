---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Masthead from "../../components/Masthead.astro";
import CookieConsent from "../../components/CookieConsent.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import { formatReadingTime } from "../../utils/readingTime";
import { getTranslation, type Locale } from "../../i18n";

export async function getStaticPaths() {
	return [
		{ params: { lang: "en" }, props: { locale: "en" as Locale } },
		{ params: { lang: "nl" }, props: { locale: "nl" as Locale } },
	];
}

const { locale } = Astro.props;
const t = getTranslation(locale);

const posts = (await getCollection("blog"))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang={locale}>
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<!-- Skip to main content link -->
		<a href="#main-content" class="skip-link">
			Skip to main content
		</a>
		<a href="#page-nav" class="skip-link">
			Skip to navigation
		</a>

		<Masthead currentPath={Astro.url.pathname} locale={locale} t={t} />

		<main
			class="reading-column"
			id="main-content"
			style="max-width: var(--measure); margin: 0 auto; padding: var(--space-6) var(--margin-page);"
		>
			<header style="margin-bottom: var(--space-7); padding-bottom: var(--space-5); border-bottom: 1px solid var(--mountain-light); text-align: center;">
				<h1 style="font-size: var(--size-3xl); margin-bottom: var(--space-3);">
					{SITE_TITLE}
				</h1>
				<p style="font-size: var(--size-lg); color: var(--ink-muted); font-style: italic; max-width: 60ch; margin: 0 auto;">
					{t.home.heroSubtitle}
				</p>
			</header>

			<section style="margin-bottom: var(--space-7);">
				<h2 class="folded-heading" style="margin-left: 0;">
					<span class="section-number">01</span>
					{t.ui.latestEssays}
				</h2>

				<ul style="list-style: none; padding: 0; display: grid; gap: var(--space-4);">
					{posts.map((post) => (
						<li style="border: 1px solid var(--mountain-light); border-radius: var(--radius); padding: var(--space-4); background: var(--sheet-darker); transition: border-color var(--transition-base), box-shadow var(--transition-base);">
							<a
								href={`/${locale}/blog/${post.id}/`}
								style="text-decoration: none; color: inherit; display: block;"
							>
								<h3 style="margin: 0 0 var(--space-2); font-size: var(--size-xl); color: var(--ink); transition: color var(--transition-base);">
									{post.data.title}
								</h3>
								<p style="color: var(--ink-muted); margin: 0 0 var(--space-2);">
									{post.data.description}
								</p>
								<div style="display: flex; flex-wrap: wrap; gap: var(--space-3); font-size: var(--size-sm); color: var(--ink-muted); font-family: var(--font-structural); align-items: center;">
									<time
										datetime={post.data.pubDate.toISOString()}
										style="font-variant-numeric: tabular-nums;"
									>
										{new Intl.DateTimeFormat(
											locale === "nl" ? "nl-NL" : "en-US",
											{ dateStyle: "medium" },
										).format(post.data.pubDate)}
									</time>
									<span aria-hidden="true">•</span>
									<span>
										{formatReadingTime(
											post.data.readingTime || 0,
										)}
									</span>
									{post.data.tags.length > 0 && (
										<span style="color: var(--gold);">
											{post.data.tags
												.slice(0, 2)
												.join(", ")}
											{post.data.tags.length > 2
												? "…"
												: ""}
										</span>
									)}
								</div>
							</a>
						</li>
					))}
				</ul>

				<p style="text-align: center; margin-top: var(--space-6);">
					<a
						href={`/${locale}/blog`}
						style="font-family: var(--font-structural); font-weight: 600; text-decoration: none; color: var(--gold); border-bottom: 1px solid var(--gold); padding-bottom: 2px;"
					>
						{t.home.aboutTitle} →
					</a>
					<span style="margin: 0 var(--space-3); color: var(--mountain);">
						|
					</span>
					<a
						href={`/${locale}/topics`}
						style="font-family: var(--font-structural); font-weight: 600; text-decoration: none; color: var(--gold); border-bottom: 1px solid var(--gold); padding-bottom: 2px;"
					>
						{t.nav.topics} →
					</a>
					<span style="margin: 0 var(--space-3); color: var(--mountain);">
						|
					</span>
					<a
						href={`/${locale}/search`}
						style="font-family: var(--font-structural); font-weight: 600; text-decoration: none; color: var(--gold); border-bottom: 1px solid var(--gold); padding-bottom: 2px;"
					>
						{t.nav.search} →
					</a>
				</p>
			</section>

			<section style="margin-bottom: var(--space-7);">
				<h2 class="folded-heading" style="margin-left: 0;">
					<span class="section-number">02</span>
					{t.home.aboutTitle}
				</h2>

				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-4);">
					<article style="border: 1px solid var(--mountain-light); border-radius: var(--radius); padding: var(--space-4); background: var(--sheet);">
						<h3 style="margin: 0 0 var(--space-2); font-size: var(--size-lg); color: var(--ink);">
							Agent Bounding
						</h3>
						<p style="color: var(--ink-muted); margin: 0 0 var(--space-3); font-size: var(--size-sm);">
							Schema enforcement, tool sandboxing, capability
							tokens — when to use which.
						</p>
						<a
							href={`/${locale}/blog/bounding-llm-agents`}
							style="font-family: var(--font-structural); font-size: var(--size-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--gold); text-decoration: none;"
						>
							Read pattern →
						</a>
					</article>

					<article style="border: 1px solid var(--mountion-light); border-radius: var(--radius); padding: var(--space-4); background: var(--sheet);">
						<h3 style="margin: 0 0 var(--space-2); font-size: var(--size-lg); color: var(--ink);">
							Observability Spine
						</h3>
						<p style="color: var(--ink-muted); margin: 0 0 var(--space-3); font-size: var(--size-sm);">
							Structured logging, distributed tracing, and
							evaluation hooks for agent workflows.
						</p>
						<a
							href={`/${locale}/blog/observability-patterns`}
							style="font-family: var(--font-structural); font-size: var(--size-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--gold); text-decoration: none;"
						>
							Read pattern →
						</a>
					</article>

					<article style="border: 1px solid var(--mountain-light); border-radius: var(--radius); padding: var(--space-4); background: var(--sheet);">
						<h3 style="margin: 0 0 var(--space-2); font-size: var(--size-lg); color: var(--ink);">
							Cost Envelope
						</h3>
						<p style="color: var(--ink-muted); margin: 0 0 var(--space-3); font-size: var(--size-sm);">
							Token budgets, circuit breakers, and
							capability-based pricing models.
						</p>
						<a
							href={`/${locale}/blog/cost-envelopes`}
							style="font-family: var(--font-structural); font-size: var(--size-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--gold); text-decoration: none;"
						>
							Read pattern →
						</a>
					</article>

					<article style="border: 1px solid var(--mountain-light); border-radius: var(--radius); padding: var(--space-4); background: var(--sheet);">
						<h3 style="margin: 0 0 var(--space-2); font-size: var(--size-lg); color: var(--ink);">
							Failure Mode Taxonomy
						</h3>
						<p style="color: var(--ink-muted); margin: 0 0 var(--space-3); font-size: var(--size-sm);">
							Classifying agent failures: hallucination, tool
							misuse, planning errors, cascade failures.
						</p>
						<a
							href={`/${locale}/blog/failure-mode-taxonomy`}
							style="font-family: var(--font-structural); font-size: var(--size-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--gold); text-decoration: none;"
						>
							Read pattern →
						</a>
					</article>
				</div>
			</section>

			<section style="border-top: 1px solid var(--mountain-light); padding-top: var(--space-6); text-align: center;">
				<h2
					class="folded-heading"
					style="margin-left: 0; display: inline-block;"
				>
					<span class="section-number">03</span>
					{t.home.aboutTitle}
				</h2>

				<p style="max-width: 50ch; margin: var(--space-4) auto 0; color: var(--ink-muted);">
					{t.home.aboutText}
				</p>

				<p style="margin-top: var(--space-4); font-size: var(--size-sm); color: var(--ink-muted); font-family: var(--font-structural);">
					{t.home.techStack}
				</p>
			</section>
		</main>

		<Footer locale={locale} t={t} />

		<!-- Cookie Consent Banner -->
		<CookieConsent locale={locale} t={t} />
	</body>
</html>
