---
/**
 * ThemeToggle — accessible three-option theme selector (System, Light, Dark).
 * Honors prefers-color-scheme, persists explicit preferences in localStorage,
 * and avoids flashes of incorrect theme (FOUC) via inline script in BaseHead.
 */
import { getTranslation, type Locale } from "../i18n";
import type { TranslationKeys } from "../i18n";

interface Props {
	locale: Locale;
	t: TranslationKeys;
}

const { locale, t } = Astro.props;

const themes = [
	{ value: "system", label: t.theme.system, icon: "" },
	{ value: "light", label: t.theme.light, icon: "" },
	{ value: "dark", label: t.theme.dark, icon: "" },
] as const;

type Theme = (typeof themes)[number]["value"];
---

<div class="theme-toggle" role="group" aria-label={t.theme.label}>
	{themes.map((theme) => (
		<button
			type="button"
			class={`theme-btn ${theme.value}`}
			data-theme={theme.value}
			aria-pressed="false"
			aria-label={theme.label}
			title={theme.label}
		>
			<span class="theme-icon" aria-hidden="true">
				{theme.icon}
			</span>
			<span class="theme-label">{theme.label}</span>
		</button>
	))}
</div>

<script>
	// ThemeToggle client-side logic
	(function () {
		const STORAGE_KEY = "theme-preference";
		const THEME_ATTR = "data-theme";
		const buttons =
			document.querySelectorAll<HTMLButtonElement>(".theme-btn");
		const html = document.documentElement;

		// Get saved preference or default to 'system'
		function getSavedTheme(): "system" | "light" | "dark" {
			const saved = localStorage.getItem(STORAGE_KEY);
			if (saved === "light" || saved === "dark" || saved === "system") {
				return saved;
			}
			return "system";
		}

		// Apply theme to document
		function applyTheme(theme: "system" | "light" | "dark") {
			if (theme === "system") {
				html.removeAttribute(THEME_ATTR);
			} else {
				html.setAttribute(THEME_ATTR, theme);
			}
		}

		// Update button states
		function updateButtons(activeTheme: "system" | "light" | "dark") {
			buttons.forEach((btn) => {
				const isActive = btn.getAttribute("data-theme") === activeTheme;
				btn.setAttribute("aria-pressed", isActive.toString());
			});
		}

		// Get system preference
		function getSystemTheme(): "light" | "dark" {
			return window.matchMedia("(prefers-color-scheme: dark)").matches
				? "dark"
				: "light";
		}

		// Initialize
		let currentTheme = getSavedTheme();
		applyTheme(currentTheme);
		updateButtons(currentTheme);

		// Listen for system preference changes (only relevant in 'system' mode)
		const mediaQuery = window.matchMedia("(prefers-color-scheme: dark)");
		mediaQuery.addEventListener("change", () => {
			if (currentTheme === "system") {
				applyTheme("system");
			}
		});

		// Button click handlers
		buttons.forEach((btn) => {
			btn.addEventListener("click", () => {
				const theme = btn.getAttribute("data-theme") as
					"system" | "light" | "dark";
				currentTheme = theme;
				localStorage.setItem(STORAGE_KEY, theme);
				applyTheme(theme);
				updateButtons(theme);
			});
		});

		// Keyboard navigation within the group
		const container = document.querySelector(".theme-toggle");
		if (container) {
			container.addEventListener("keydown", (e) => {
				if (!(e instanceof KeyboardEvent)) return;
				const activeBtn = document.querySelector(
					'.theme-btn[aria-pressed="true"]',
				);
				const btns = Array.from(buttons);
				const currentIndex = btns.indexOf(
					activeBtn as HTMLButtonElement,
				);

				let nextIndex = currentIndex;
				if (e.key === "ArrowRight" || e.key === "ArrowDown") {
					nextIndex = (currentIndex + 1) % btns.length;
					e.preventDefault();
				} else if (e.key === "ArrowLeft" || e.key === "ArrowUp") {
					nextIndex = (currentIndex - 1 + btns.length) % btns.length;
					e.preventDefault();
				} else if (e.key === "Home") {
					nextIndex = 0;
					e.preventDefault();
				} else if (e.key === "End") {
					nextIndex = btns.length - 1;
					e.preventDefault();
				}

				if (nextIndex !== currentIndex) {
					btns[nextIndex].focus();
				}
			});
		}
	})();
</script>

<style>
	.theme-toggle {
		display: inline-flex;
		gap: var(--space-1);
		background: var(--sheet-darker);
		border-radius: var(--radius);
		padding: var(--space-1);
		border: 1px solid var(--mountain-light);
	}

	.theme-btn {
		font-family: var(--font-structural);
		font-size: var(--size-xs);
		font-weight: 600;
		padding: var(--space-1) var(--space-2);
		background: var(--sheet);
		border: 1px solid var(--mountain-light);
		border-radius: calc(var(--radius) - 1px);
		color: var(--ink);
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-1);
		min-width: 44px; /* Touch target */
		transition:
			color var(--transition-base),
			background var(--transition-base),
			border-color var(--transition-base);
		white-space: nowrap;
	}

	.theme-btn:hover,
	.theme-btn:focus {
		color: var(--gold);
		background: var(--valley-light);
		outline: none;
	}

	.theme-btn:focus-visible {
		outline: 2px solid var(--focus);
		outline-offset: 2px;
	}

	.theme-btn[aria-pressed="true"] {
		color: var(--sheet);
		background: var(--gold);
		border-color: var(--gold);
	}

	/* Dark theme - ensure theme labels have sufficient contrast */
	[data-theme="dark"] .theme-btn {
		color: var(--ink-dark);
		border-color: var(--mountain-light-dark);
		background: var(--sheet-dark);
	}
	[data-theme="dark"] .theme-btn:hover,
	[data-theme="dark"] .theme-btn:focus {
		color: var(--gold-dark);
		background: var(--valley-light-dark);
		border-color: var(--gold-dark);
	}
	[data-theme="dark"] .theme-btn[aria-pressed="true"] {
		color: var(--sheet-dark);
		background: var(--gold-dark);
		border-color: var(--gold-dark);
	}

	/* Hide icons on very small screens if needed */
	@media (max-width: 480px) {
		.theme-label {
			display: none;
		}
		.theme-btn {
			padding: var(--space-1);
		}
	}
</style>
