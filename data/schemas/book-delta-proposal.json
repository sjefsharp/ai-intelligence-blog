{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-intelligence-blog/schemas/book-delta-proposal.json",
  "title": "Book Delta Proposal",
  "description": "Structured proposal for improving educational knowledge and explanatory material based on verified daily research findings. Not a source of factual truth, not a replacement for thesaurus or architecture principles.",
  "type": "object",
  "properties": {
    "proposalId": {
      "type": "string",
      "pattern": "^bdp_[a-z0-9]{16}$"
    },
    "editionId": {
      "type": "string",
      "pattern": "^edition_\\d{4}-\\d{2}-\\d{2}$"
    },
    "editionDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "category": {
      "type": "string",
      "enum": [
        "ADD",
        "REFINE",
        "CORRECT",
        "EXTEND",
        "RESTRUCTURE",
        "DEPRECATE",
        "NONE"
      ]
    },
    "title": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "nl": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["en", "nl"],
      "additionalProperties": false
    },
    "knowledgeDomain": {
      "type": "string",
      "enum": [
        "agentic-ai-software-engineering",
        "models-inference-scientific",
        "architecture-security-governance",
        "enterprise-adoption-organizational",
        "economics-business-impact",
        "independent-research-advisory",
        "cross-cutting"
      ]
    },
    "targetAudience": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "system-architects",
          "principal-engineers",
          "ml-platform-leads",
          "technical-ctos",
          "senior-engineers-ai-track",
          "security-architects",
          "cost-engineers",
          "general-technical",
          "interdisciplinary"
        ]
      }
    },
    "targetConcept": {
      "type": "string",
      "minLength": 1
    },
    "targetDocument": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string"
        },
        "documentTitle": {
          "type": "string"
        },
        "sectionPath": {
          "type": "string"
        },
        "accessibility": {
          "type": "string",
          "enum": ["accessed", "inaccessible", "unidentified", "does-not-exist"]
        },
        "lastAccessedAt": {
          "type": "string"
        },
        "accessNote": {
          "type": "string"
        },
        "comparisonPerformed": {
          "type": "boolean"
        },
        "comparisonResult": {
          "type": "string",
          "enum": ["gap-confirmed", "no-gap", "inconclusive", "not-performed"]
        }
      },
      "required": ["accessibility", "comparisonPerformed"],
      "additionalProperties": false
    },
    "currentGap": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "nl": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["en", "nl"],
      "additionalProperties": false
    },
    "proposedChange": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "nl": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["en", "nl"],
      "additionalProperties": false
    },
    "rationale": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "nl": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["en", "nl"],
      "additionalProperties": false
    },
    "supportingClaimIds": {
      "minItems": 0,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^claim_[a-z0-9]{16}$"
      }
    },
    "originalSources": {
      "minItems": 0,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "anyOf": [
              {
                "type": "number",
                "const": 1
              },
              {
                "type": "number",
                "const": 2
              },
              {
                "type": "number",
                "const": 3
              }
            ]
          },
          "section": {
            "type": "string"
          },
          "accessedAt": {
            "type": "string"
          },
          "retrievalStatus": {
            "type": "string",
            "enum": [
              "CHECKED_FOUND",
              "CHECKED_NONE",
              "INACCESSIBLE",
              "NOT_CHECKED",
              "ERROR"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "sourceId",
          "url",
          "title",
          "tier",
          "accessedAt",
          "retrievalStatus",
          "confidence"
        ],
        "additionalProperties": false
      }
    },
    "researchDates": {
      "type": "object",
      "properties": {
        "earliestFinding": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "latestFinding": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "primaryEditionDates": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      },
      "required": ["earliestFinding", "latestFinding", "primaryEditionDates"],
      "additionalProperties": false
    },
    "evidenceClassification": {
      "type": "string",
      "enum": [
        "VERIFIED_FACT",
        "VENDOR_CLAIM",
        "RESEARCH_FINDING",
        "ORIGINAL_REPORTING",
        "EXPERT_INTERPRETATION",
        "INFERENCE",
        "SPECULATION",
        "UNVERIFIED"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "materialUncertainty": {
      "type": "string",
      "enum": ["low", "medium", "high", "speculative"]
    },
    "educationalValue": {
      "type": "string",
      "enum": ["foundational", "significant", "supplementary", "niche"]
    },
    "limitations": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "terminologyReferences": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entryId": {
            "type": "string",
            "pattern": "^thes_[a-z0-9]{16}$"
          },
          "term": {
            "type": "string",
            "minLength": 1
          },
          "relationship": {
            "type": "string",
            "enum": [
              "prerequisite",
              "subject-of-proposal",
              "related-concept",
              "ambiguous-usage"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": ["entryId", "term", "relationship"],
        "additionalProperties": false
      }
    },
    "principleReferences": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "principleId": {
            "type": "string",
            "pattern": "^AP-\\d{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "relationship": {
            "type": "string",
            "enum": [
              "illustrates",
              "requires-explanation",
              "tradeoff-example",
              "scope-clarification"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": ["principleId", "title", "relationship"],
        "additionalProperties": false
      }
    },
    "historicalProposalReferences": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "proposalId": {
            "type": "string",
            "pattern": "^bdp_[a-z0-9]{16}$"
          },
          "editionDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "relationship": {
            "type": "string",
            "enum": [
              "unique",
              "strengthens-existing",
              "revises-scope",
              "links-related",
              "supersedes",
              "duplicate"
            ]
          },
          "resolutionNote": {
            "type": "string"
          }
        },
        "required": ["proposalId", "editionDate", "relationship"],
        "additionalProperties": false
      }
    },
    "conflicts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "otherProposalId": {
            "type": "string",
            "pattern": "^bdp_[a-z0-9]{16}$"
          },
          "conflictType": {
            "type": "string",
            "enum": [
              "overlapping-scope",
              "contradictory-change",
              "dependency",
              "sequence-required"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "resolutionApproach": {
            "type": "string"
          }
        },
        "required": ["otherProposalId", "conflictType", "description"],
        "additionalProperties": false
      }
    },
    "counterevidence": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "sourceReference": {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
