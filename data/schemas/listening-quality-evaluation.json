          "criterionId",
          "evaluationId",
          "status",
          "scope",
          "summary",
          "rationale",
          "evidence",
          "passageReferences",
          "repairAttempted",
          "method",
          "evaluatedAt",
          "evaluatedBy",
          "holisticAssessment"
