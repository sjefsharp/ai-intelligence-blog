  "required": [
    "schemaVersion",
    "reportId",
    "editionId",
    "editionDate",
    "editionWindow",
    "executionId",
    "executedAt",
    "generatedBy",
    "currentDossierVersion",
    "historicalWindow",
    "historicalEditions",
    "candidatesEvaluated",
    "relationships",
    "substantiveUpdates",
    "repeatedReporting",
    "potentialOmissions",
    "missingHistoricalEvidence",
    "unresolvedQuestions",
    "finalStatus",
    "inferenceUsed",
    "contentHash"
  ],
  "additionalProperties": false
}
