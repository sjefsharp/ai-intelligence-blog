      "required": [
        "conceptualImportance",
        "technicalAccuracy",
        "reusability",
        "multiContextRelevance",
        "prerequisiteDependencies",
        "likelihoodOfFutureChange",
        "authoritativeEvidenceAvailable",
        "practicalApplicability",
        "correctsRecurringMisconception",
        "progressiveLearningValue",
        "maintenanceCostEstimate"
