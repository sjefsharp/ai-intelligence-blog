                "type": "string",
                "format": "uri"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "tier": {
                "anyOf": [
                  {
                    "type": "number",
                    "const": 1
                  },
                  {
                    "type": "number",
                    "const": 2
                  },
                  {
                    "type": "number",
                    "const": 3
                  }
                ]
              },
              "section": {
                "type": "string"
              },
              "accessedAt": {
                "type": "string"
              },
              "retrievalStatus": {
                "type": "string",
                "enum": [
                  "CHECKED_FOUND",
                  "CHECKED_NONE",
                  "INACCESSIBLE",
                  "NOT_CHECKED",
                  "ERROR"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "sourceId",
              "url",
              "title",
              "tier",
              "accessedAt",
              "retrievalStatus",
              "confidence"
            ],
            "additionalProperties": false
          },
          "evidenceClassification": {
            "type": "string",
            "enum": [
              "VERIFIED_FACT",
              "VENDOR_CLAIM",
              "RESEARCH_FINDING",
              "ORIGINAL_REPORTING",
              "EXPERT_INTERPRETATION",
              "INFERENCE",
              "SPECULATION",
              "UNVERIFIED"
            ]
          },
          "impact": {
            "type": "string",
            "enum": ["qualifying", "limiting", "contradictory"]
