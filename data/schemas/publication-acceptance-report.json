{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-intelligence-blog/schemas/publication-acceptance-report.json",
  "title": "Publication Acceptance Report",
  "description": "Structured, persistent acceptance report containing edition identity, workflow run, gate inventory, gate results, evidence references, artifact hashes, defects, lifecycle state, deployment eligibility, and rejection reasons.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "reportId": {
      "type": "string",
      "pattern": "^acc_[a-z0-9]{16}$"
    },
    "editionId": {
      "type": "string",
      "pattern": "^edition_\\d{4}-\\d{2}-\\d{2}$"
    },
    "workflowRunId": {
      "type": "string",
      "minLength": 1
    },
    "acceptanceContractVersion": {
      "type": "string",
      "minLength": 1
    },
    "acceptanceTimestamp": {
      "type": "string"
    },
    "reportingInterval": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        },
        "timezone": {
          "type": "string",
          "const": "Europe/Amsterdam"
        }
      },
      "required": ["start", "end", "timezone"],
      "additionalProperties": false
    },
    "overallDecision": {
      "type": "string",
      "enum": ["VALIDATED", "FAILED", "INCOMPLETE", "NOT_ASSESSABLE"]
    },
    "requiredGates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "gateId": {
            "type": "string",
            "pattern": "^gate_[a-z0-9_]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "enum": [
              "edition",
              "artifact",
              "claim",
              "source",
              "visualization",
              "knowledge"
            ]
          },
          "requiredInputArtifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requiredUpstreamGates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "applicabilityConditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "validationRules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidenceReferences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evaluatorVersion": {
            "type": "string",
            "minLength": 1
          },
          "humanReviewRequired": {
            "default": false,
            "type": "boolean"
          },
          "mandatory": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "gateId",
          "name",
          "purpose",
          "scope",
          "requiredInputArtifacts",
          "requiredUpstreamGates",
          "applicabilityConditions",
          "validationRules",
          "evidenceReferences",
          "evaluatorVersion",
          "humanReviewRequired",
          "mandatory"
        ],
        "additionalProperties": false
      }
    },
    "gateApplicability": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "enum": ["APPLICABLE", "NOT_APPLICABLE"]
      }
    },
    "gateResults": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "gateId": {
            "type": "string",
            "pattern": "^gate_[a-z0-9_]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["PASS", "FAIL", "UNVERIFIED", "NOT_ASSESSABLE"]
          },
          "applicability": {
            "type": "string",
            "enum": ["APPLICABLE", "NOT_APPLICABLE"]
          },
          "applicabilityReason": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": ["CRITICAL", "MAJOR", "MINOR", "ADVISORY"]
          },
          "blockingConditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidenceReferences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "artifactHashes": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "evaluatorVersion": {
            "type": "string",
            "minLength": 1
          },
          "executedAt": {
            "type": "string"
          },
          "remediationReferences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "residualUncertainty": {
            "type": "string"
          },
          "humanReviewRequired": {
            "default": false,
            "type": "boolean"
          },
          "humanReviewStatus": {
            "default": "not-required",
            "type": "string",
            "enum": ["not-required", "pending", "approved", "rejected"]
          },
          "mandatory": {
            "default": true,
            "type": "boolean"
          },
          "satisfiedUpstreamGates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unsatisfiedUpstreamGates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "gateId",
          "name",
          "status",
          "applicability",
          "blockingConditions",
          "evidenceReferences",
          "artifactHashes",
          "evaluatorVersion",
          "executedAt",
          "remediationReferences",
          "humanReviewRequired",
          "humanReviewStatus",
          "mandatory",
          "satisfiedUpstreamGates",
          "unsatisfiedUpstreamGates"
        ],
        "additionalProperties": false
      }
    },
    "evidenceReferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifactHashes": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "factDossierReference": {
      "type": "object",
      "properties": {
        "dossierId": {
          "type": "string",
          "pattern": "^fd_[a-z0-9]{16}$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": ["dossierId", "contentHash"],
      "additionalProperties": false
    },
    "editorialManifestReference": {
      "type": "object",
      "properties": {
        "manifestId": {
          "type": "string",
          "pattern": "^esm_[a-z0-9]{16}$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": ["manifestId", "contentHash"],
      "additionalProperties": false
    },
    "criticalAndMajorDefects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "defectId": {
            "type": "string",
            "minLength": 1
          },
          "gateId": {
            "type": "string",
            "pattern": "^gate_[a-z0-9_]+$"
          },
          "category": {
            "type": "string",
            "enum": [
              "MISSING_EVIDENCE",
              "INVALID_EVIDENCE",
              "STALE_EVIDENCE",
              "CONTRADICTION",
              "FABRICATION",
              "INCOMPLETE_COVERAGE",
              "INVALID_LIFECYCLE",
              "ARTIFACT_INTEGRITY",
              "CROSS_LANGUAGE_INCONSISTENCY",
              "TEMPORAL_ELIGIBILITY",
              "SOURCE_PROVENANCE",
              "EDITORIAL_INTEGRITY",
              "READABILITY_DEFECT",
              "AUDIO_QUALITY_DEFECT",
              "KNOWLEDGE_CONTINUITY_DEFECT",
              "VISUALIZATION_DEFECT",
              "METADATA_DEFECT",
              "OTHER"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": ["CRITICAL", "MAJOR", "MINOR", "ADVISORY"]
          },
          "blocking": {
            "type": "boolean"
          },
          "affectedArtifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidenceReferences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "responsibleComponent": {
            "type": "string",
            "minLength": 1
          },
          "remediationRecommendation": {
            "type": "string",
            "minLength": 1
          },
          "identifiedAt": {
            "type": "string"
          }
        },
        "required": [
          "defectId",
          "gateId",
          "category",
          "description",
          "severity",
          "blocking",
          "affectedArtifacts",
          "evidenceReferences",
          "responsibleComponent",
          "remediationRecommendation",
          "identifiedAt"
        ],
        "additionalProperties": false
      }
    },
    "unverifiedRequirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolvedManualReview": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remediationHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "remediationId": {
            "type": "string",
            "minLength": 1
          },
          "gateId": {
            "type": "string"
          },
          "defectId": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "result": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        },
        "required": [
          "remediationId",
          "gateId",
          "defectId",
          "action",
          "result",
          "timestamp"
        ],
        "additionalProperties": false
      }
    },
    "publicationLifecycleState": {
      "type": "string",
      "enum": [
        "DRAFT",
        "READY_FOR_VALIDATION",
        "VALIDATED",
        "PUBLISHED",
        "FAILED",
        "INCOMPLETE",
        "SUPERSEDED"
      ]
    },
    "deploymentEligible": {
      "type": "boolean"
    },
    "rejectionReasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "persistenceReadback": {
      "type": "object",
      "properties": {
        "persisted": {
          "type": "boolean"
        },
        "readbackVerified": {
          "type": "boolean"
        },
        "reportPath": {
          "type": "string"
        },
        "verifiedAt": {
          "type": "string"
        }
      },
      "required": ["persisted", "readbackVerified"],
      "additionalProperties": false
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "reportId",
    "editionId",
    "workflowRunId",
    "acceptanceContractVersion",
    "acceptanceTimestamp",
    "reportingInterval",
    "overallDecision",
    "requiredGates",
    "gateApplicability",
    "gateResults",
    "evidenceReferences",
    "artifactHashes",
    "factDossierReference",
    "editorialManifestReference",
    "criticalAndMajorDefects",
    "unverifiedRequirements",
    "unresolvedManualReview",
    "remediationHistory",
    "publicationLifecycleState",
    "deploymentEligible",
    "rejectionReasons",
    "persistenceReadback",
    "contentHash"
  ],
  "additionalProperties": false
}
