---
/**
 * Footer — minimal, consistent with Miura-fold design system.
 * No social links by default (publication has no social media by design).
 */
import { getTranslation, type Locale, type TranslationKeys } from "../i18n";

interface Props {
	locale: Locale;
	t: TranslationKeys;
}

const { locale, t } = Astro.props;
const today = new Date();
---

<footer class="footer">
	<p>
		&copy; {today.getFullYear()} AI Intelligence Blog. {t.footer.rights}
	</p>
	<p style="margin-top: var(--space-2); font-family: var(--font-structural); font-size: var(--size-xs); color: var(--ink-muted);">
		{t.footer.noTracking} ·{" "}
		<a href={`/${locale}/rss.xml`}>{t.footer.rss}</a> ·{" "}
		<a href={`/${locale}/sitemap-index.xml`}>{t.footer.sitemap}</a>
	</p>
</footer>
