{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-intelligence-blog/schemas/listening-quality-evaluation.json",
  "title": "Listening Quality Evaluation Report",
  "description": "Structured evaluation of the Dutch listening narrative against Q1-Q10 and Audio A-G criteria covering factual fidelity, technical depth, narrative coherence, cognitive accessibility, and holistic listening experience suitability for adults listening without visual support.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "reportId": {
      "type": "string"
    },
    "editionId": {
      "type": "string"
    },
    "editionDate": {
      "type": "string"
    },
    "listeningNarrativeArtifactId": {
      "type": "string"
    },
    "factDossierId": {
      "type": "string"
    },
    "editorialSelectionManifestId": {
      "type": "string"
    },
    "criterionEvaluations": {
      "minItems": 17,
      "maxItems": 17,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterionId": {
            "type": "string"
          },
          "evaluationId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["PASS", "FAIL", "UNVERIFIED", "NOT_ASSESSABLE"]
          },
          "severity": {
            "type": "string",
            "enum": ["CRITICAL", "MAJOR", "MINOR", "ADVISORY"]
          },
          "scope": {
            "type": "string",
            "enum": [
              "full-narrative",
              "per-story",
              "opening",
              "transitions",
              "conclusion",
              "specific-passage"
            ]
          },
          "summary": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["deterministic", "model-assisted", "evidence-based"]
                },
                "description": {
                  "type": "string"
                },
                "passageReferences": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "characterOffset": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "lineNumber": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "sectionHeading": {
                        "type": "string"
                      },
                      "quote": {
                        "type": "string",
                        "maxLength": 500
                      },
                      "storyId": {
                        "type": "string",
                        "pattern": "^story_[a-z0-9]{16}$"
                      }
                    },
                    "required": ["characterOffset", "quote"],
                    "additionalProperties": false
                  }
                },
                "claimIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "sourceIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "metadata": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "required": [
                "type",
                "description",
                "passageReferences",
                "claimIds",
                "sourceIds"
              ],
              "additionalProperties": false
            }
          },
          "passageReferences": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "characterOffset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "lineNumber": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "sectionHeading": {
                  "type": "string"
                },
                "quote": {
                  "type": "string",
                  "maxLength": 500
                },
                "storyId": {
                  "type": "string",
                  "pattern": "^story_[a-z0-9]{16}$"
                }
              },
              "required": ["characterOffset", "quote"],
              "additionalProperties": false
            }
          },
          "repairAttempted": {
            "type": "boolean"
          },
          "repairActionId": {
            "type": "string"
          },
          "reassessment": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": ["PASS", "FAIL", "UNVERIFIED", "NOT_ASSESSABLE"]
              },
              "summary": {
                "type": "string"
              },
              "reassessedAt": {
                "type": "string"
              }
            },
            "required": ["status", "summary", "reassessedAt"],
            "additionalProperties": false
