{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-intelligence-blog/schemas/publication-metadata.json",
  "title": "Publication Metadata",
  "description": "Metadata for a single publication artifact (canonical or derivative).",
  "type": "object",
  "properties": {
    "artifactId": {
      "type": "string",
      "pattern": "^pubart_[a-z0-9]{16}$"
    },
    "editionId": {
      "type": "string",
      "pattern": "^edition_\\d{4}-\\d{2}-\\d{2}$"
    },
    "editionDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "contentType": {
      "type": "string",
      "enum": [
        "newsletter",
        "research-audit",
        "listening-narrative",
        "daily-index",
        "english-derivative",
        "english-listening"
      ]
    },
    "language": {
      "type": "string",
      "enum": ["nl", "en"]
    },
    "canonicalFilename": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "articleId": {
      "type": "string",
      "pattern": "^art_[a-z0-9]{16}$"
    },
    "publicationTimestamp": {
      "type": "string",
      "minLength": 1
    },
    "originalNewsDisclosureTimestamp": {
      "type": "string"
    },
    "lastSubstantiveUpdateTimestamp": {
      "type": "string"
    },
    "readingTimeMinutes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "estimatedListeningDurationMinutes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "sourceReferences": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "claimReferences": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^claim_[a-z0-9]{16}$"
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "organizations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lifecycleStatus": {
      "type": "string",
      "enum": [
        "DRAFT",
        "READY_FOR_VALIDATION",
        "VALIDATED",
        "PUBLISHED",
        "FAILED",
        "INCOMPLETE",
        "SUPERSEDED"
      ]
    },
    "validationStatus": {
      "type": "string",
      "enum": ["pending", "passed", "failed", "skipped"]
    },
    "validationResults": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "gate": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "details": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        },
        "required": ["gate", "passed", "timestamp"],
        "additionalProperties": false
      }
    },
    "relatedVariants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "contentType": {
            "type": "string",
            "enum": [
              "newsletter",
              "research-audit",
              "listening-narrative",
              "daily-index",
              "english-derivative",
              "english-listening"
            ]
          },
          "language": {
            "type": "string",
            "enum": ["nl", "en"]
          },
          "artifactId": {
            "type": "string",
            "pattern": "^pubart_[a-z0-9]{16}$"
          },
          "relationship": {
            "type": "string",
            "enum": ["translation", "derivative", "source", "listening-text"]
          }
        },
        "required": ["contentType", "language", "artifactId", "relationship"],
        "additionalProperties": false
      }
    },
    "version": {
      "default": 1,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "artifactId",
    "editionId",
    "editionDate",
    "contentType",
    "language",
    "canonicalFilename",
    "title",
    "description",
    "publicationTimestamp",
    "sourceReferences",
    "claimReferences",
    "topics",
    "organizations",
    "lifecycleStatus",
    "validationStatus",
    "validationResults",
    "relatedVariants",
    "version",
    "schemaVersion"
  ],
  "additionalProperties": false
}
