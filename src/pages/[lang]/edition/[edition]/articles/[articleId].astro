---
import BaseHead from "../../../../../components/BaseHead.astro";
import Footer from "../../../../../components/Footer.astro";
import Masthead from "../../../../../components/Masthead.astro";
import CookieConsent from "../../../../../components/CookieConsent.astro";
import ReadAloud from "../../../../../components/ReadAloud.astro";
import { getTranslation, type Locale } from "../../../../../i18n";
import { withBase } from "../../../../../i18n";
import {
	loadEditionContent,
	getEditionPaths,
	getEditionAlternateUrls,
	formatEditionDate,
	getReadingTime,
} from "../../../../../lib/publication/astro-adapter.js";

export async function getStaticPaths() {
	const paths = await getEditionPaths();
	const result = [];

	for (const path of paths) {
		const edition = await loadEditionContent(path.props.editionDate);
		const publicArticles = edition?.englishArticles.filter(
			(a) =>
				a.metadata.lifecycleStatus === "VALIDATED" ||
				a.metadata.lifecycleStatus === "PUBLISHED",
		);
		if (publicArticles) {
			for (const article of publicArticles) {
				result.push({
					params: {
						lang: path.params.lang,
						edition: path.params.edition,
						articleId: article.metadata.artifactId,
					},
					props: {
						editionDate: path.props.editionDate,
						locale: path.props.locale,
						articleArtifactId: article.metadata.artifactId,
					},
				});
			}
		}
	}

	return result;
}

const { locale, editionDate, articleArtifactId } = Astro.props;
const t = getTranslation(locale);

const edition = await loadEditionContent(editionDate);

if (!edition) {
	return Astro.redirect(withBase(`/${locale}/404`));
}

const article = edition.englishArticles.find(
	(a) => a.metadata.artifactId === articleArtifactId,
);

if (
	!article ||
	(article.metadata.lifecycleStatus !== "VALIDATED" &&
		article.metadata.lifecycleStatus !== "PUBLISHED")
) {
	return Astro.redirect(withBase(`/${locale}/404`));
}

// Find the Dutch source artifact through relatedVariants
const dutchSourceArtifactId = article.metadata.relatedVariants.find(
	(v) => v.relationship === "translation",
)?.artifactId;
const dutchSource = dutchSourceArtifactId ? edition.newsletter : null;

const pageTitle = article.metadata.title;
const pageDescription = article.metadata.description;

const canonicalURL = Astro.site
	? new URL(Astro.url.pathname, Astro.site)
	: new URL(Astro.url.pathname, "https://example.com");
const alternateUrls = getEditionAlternateUrls(
	editionDate,
	Astro.url.pathname,
	Astro.site,
);

// Add alternate for Dutch source if available
if (dutchSource && locale === "en") {
	alternateUrls.push({
		lang: "nl",
		url: Astro.site
			? new URL(
					`/nl/edition/${editionDate}/newsletter/`,
					Astro.site,
				).toString()
			: `/nl/edition/${editionDate}/newsletter/`,
	});
} else if (dutchSource && locale === "nl") {
	alternateUrls.push({
		lang: "en",
		url: Astro.site
			? new URL(
					`/en/edition/${editionDate}/articles/${articleArtifactId}/`,
					Astro.site,
				).toString()
			: `/en/edition/${editionDate}/articles/${articleArtifactId}/`,
	});
}
---

<!doctype html>
<html lang={locale}>
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<link rel="canonical" href={canonicalURL} />
		{alternateUrls.map((alt) => (
			<link rel="alternate" hreflang={alt.lang} href={alt.url} />
		))}
		<link
			rel="alternate"
			hreflang="x-default"
			href={
				alternateUrls.find((a) => a.lang === "en")?.url ||
				`/en/edition/${editionDate}/articles/${articleArtifactId}/`
			}
		/>
	</head>
	<body>
		<a href="#main-content" class="skip-link">
			Skip to main content
		</a>
		<a href="#page-nav" class="skip-link">
			Skip to navigation
		</a>

		<Masthead currentPath={Astro.url.pathname} locale={locale} t={t} />

		<div class="article-layout">
			<aside class="fold-margin" aria-hidden="true">
				<div class="fold-margin-line"></div>
			</aside>

			<main class="reading-column" id="main-content" role="main">
				<article class="prose">
					<header class="article-header">
						<div class="article-meta">
							<time datetime={editionDate}>
								{formatEditionDate(editionDate, locale)}
							</time>
							<span class="meta-separator" aria-hidden="true">
								•
							</span>
							<span>{getReadingTime(article)} min read</span>
							{article.metadata.topics.length > 0 && (
								<>
									<span
										class="meta-separator"
										aria-hidden="true"
									>
										•
									</span>
									<span
										class="article-tags"
										style="display: inline-flex; gap: var(--space-1); flex-wrap: wrap;"
									>
										{article.metadata.topics.map(
											(topic) => (
												<a
													href={withBase(
														`/${locale}/topics/${topic.toLowerCase().replace(/\s+/g, "-")}/`,
													)}
													style="
													font-family: var(--font-structural);
													font-size: var(--size-xs);
													font-weight: 600;
													color: var(--gold);
													background: var(--valley-light);
													padding: 1px 6px;
													border-radius: 999px;
													text-decoration: none;
												"
												>
													{topic}
												</a>
											),
										)}
									</span>
								</>
							)}
							{article.metadata.sourceReferences.length > 0 && (
								<>
									<span
										class="meta-separator"
										aria-hidden="true"
									>
										•
									</span>
									<a
										href={
											article.metadata.sourceReferences[0]
										}
										target="_blank"
										rel="noopener noreferrer"
										style="
											font-family: var(--font-structural);
											font-size: var(--size-xs);
											font-weight: 600;
											color: var(--valley);
											text-decoration: none;
											border-bottom: 1px dotted var(--valley);
										"
									>
										Source
									</a>
								</>
							)}
						</div>
						<h1 class="article-title">{article.metadata.title}</h1>
						<p class="article-abstract">
							{article.metadata.description}
						</p>
					</header>

					<div class="article-content">
						<slot>{article.content}</slot>
					</div>

					<ReadAloud
						locale={locale}
						t={t}
						articleSelector=".article-content"
					/>

					<footer
						class="footnotes"
						role="region"
						aria-labelledby="footnotes-heading"
					>
						<h2 id="footnotes-heading">{t.ui.references}</h2>
						<ol>
							{article.metadata.sourceReferences.map(
								(source, i) => (
									<li>
										<a
											href={source}
											target="_blank"
											rel="noopener noreferrer"
										>
											Source {i + 1}:{" "}
											{new URL(source).hostname}
										</a>
									</li>
								),
							)}
							{article.metadata.claimReferences.length > 0 && (
								<li>
									<strong>Claims:</strong>{" "}
									{article.metadata.claimReferences.map(
										(claim) => (
											<code style="margin: 0 var(--space-1); font-size: var(--size-xs);">
												{claim}
											</code>
										),
									)}
								</li>
							)}
						</ol>
						{article.metadata.relatedVariants.length > 0 && (
							<p style="margin-top: var(--space-4); font-size: var(--size-sm); color: var(--ink-muted);">
								<strong>Derived from:</strong>{" "}
								{article.metadata.relatedVariants.map((v) => (
									<code style="margin: 0 var(--space-1); font-size: var(--size-xs);">
										{v.contentType} ({v.language}) -{" "}
										{v.artifactId}
									</code>
								))}
							</p>
						)}
					</footer>
				</article>
			</main>
		</div>

		<Footer locale={locale} t={t} />
		<CookieConsent locale={locale} t={t} />
	</body>
</html>
