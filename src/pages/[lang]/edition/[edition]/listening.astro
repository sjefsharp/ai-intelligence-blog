---
import BaseHead from "../../../../components/BaseHead.astro";
import Footer from "../../../../components/Footer.astro";
import Masthead from "../../../../components/Masthead.astro";
import CookieConsent from "../../../../components/CookieConsent.astro";
import ReadAloud from "../../../../components/ReadAloud.astro";
import { getTranslation, type Locale } from "../../../../i18n";
import { withBase } from "../../../../i18n";
import {
	loadEditionContent,
	getEditionPaths,
	getEditionAlternateUrls,
	formatEditionDate,
	getListeningDuration,
} from "../../../../lib/publication/astro-adapter.js";

export async function getStaticPaths() {
	const paths = await getEditionPaths();
	const result = [];

	for (const path of paths) {
		const edition = await loadEditionContent(path.props.editionDate);
		// For Dutch: check canonical listening narrative
		// For English: check derivative listening narratives
		const hasPublicContent =
			path.props.locale === "nl"
				? edition?.listeningNarrative?.metadata.lifecycleStatus ===
						"VALIDATED" ||
					edition?.listeningNarrative?.metadata.lifecycleStatus ===
						"PUBLISHED"
				: edition?.englishListening.some(
						(a) =>
							a.metadata.lifecycleStatus === "VALIDATED" ||
							a.metadata.lifecycleStatus === "PUBLISHED",
					);

		if (hasPublicContent) {
			result.push({
				params: {
					lang: path.params.lang,
					edition: path.params.edition,
				},
				props: {
					editionDate: path.props.editionDate,
					locale: path.props.locale,
				},
			});
		}
	}

	return result;
}

const { locale, editionDate } = Astro.props;
const t = getTranslation(locale);

const edition = await loadEditionContent(editionDate);

if (!edition) {
	return Astro.redirect(withBase(`/${locale}/404`));
}

// For Dutch: show canonical listening narrative
// For English: show derivative listening narratives
const nlListening = edition.listeningNarrative;
const enListening = edition.englishListening;

const isPublic =
	locale === "nl"
		? nlListening &&
			(nlListening.metadata.lifecycleStatus === "VALIDATED" ||
				nlListening.metadata.lifecycleStatus === "PUBLISHED")
		: enListening.some(
				(a) =>
					a.metadata.lifecycleStatus === "VALIDATED" ||
					a.metadata.lifecycleStatus === "PUBLISHED",
			);

if (!isPublic) {
	return Astro.redirect(withBase(`/${locale}/404`));
}

// Get the listening content for the current locale
const listening =
	locale === "nl"
		? nlListening
		: enListening.find(
				(a) =>
					a.metadata.lifecycleStatus === "VALIDATED" ||
					a.metadata.lifecycleStatus === "PUBLISHED",
			);

const pageTitle =
	listening?.metadata.title ??
	(locale === "nl"
		? "AI Daily Intelligence"
		: "AI Daily Intelligence (English)");
const pageDescription =
	listening?.metadata.description ??
	(locale === "nl"
		? `Luisternarratief voor ${formatEditionDate(editionDate, locale)}`
		: `Listening narrative for ${formatEditionDate(editionDate, locale)}`);

const canonicalURL = Astro.site
	? new URL(Astro.url.pathname, Astro.site)
	: new URL(Astro.url.pathname, "https://example.com");
const alternateUrls = getEditionAlternateUrls(
	editionDate,
	Astro.url.pathname,
	Astro.site,
);

// Add specific alternate for the counterpart
if (locale === "nl" && enListening.length > 0) {
	alternateUrls.push({
		lang: "en",
		url: Astro.site
			? new URL(
					`/en/edition/${editionDate}/listening/`,
					Astro.site,
				).toString()
			: `/en/edition/${editionDate}/listening/`,
	});
} else if (locale === "en" && nlListening) {
	alternateUrls.push({
		lang: "nl",
		url: Astro.site
			? new URL(
					`/nl/edition/${editionDate}/listening/`,
					Astro.site,
				).toString()
			: `/nl/edition/${editionDate}/listening/`,
	});
}

// Extract related variants safely
const relatedVariants = listening?.metadata.relatedVariants ?? [];
const hasRelatedVariants = relatedVariants.length > 0;
---

<!doctype html>
<html lang={locale}>
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<link rel="canonical" href={canonicalURL} />
		{alternateUrls.map((alt) => (
			<link rel="alternate" hreflang={alt.lang} href={alt.url} />
		))}
		<link
			rel="alternate"
			hreflang="x-default"
			href={
				alternateUrls.find((a) => a.lang === "en")?.url ||
				`/en/edition/${editionDate}/listening/`
			}
		/>
	</head>
	<body>
		<a href="#main-content" class="skip-link">
			Skip to main content
		</a>
		<a href="#page-nav" class="skip-link">
			Skip to navigation
		</a>

		<Masthead currentPath={Astro.url.pathname} locale={locale} t={t} />

		<div class="article-layout">
			<aside class="fold-margin" aria-hidden="true">
				<div class="fold-margin-line"></div>
			</aside>

			<main class="reading-column" id="main-content" role="main">
				<article class="prose">
					<header class="article-header">
						<div class="article-meta">
							<time datetime={editionDate}>
								{formatEditionDate(editionDate, locale)}
							</time>
							<span class="meta-separator" aria-hidden="true">
								•
							</span>
							<span>
								{getListeningDuration(listening!)} min{" "}
								{locale === "nl" ? "luisterduur" : "listen"}
							</span>
						</div>
						<h1 class="article-title">
							{listening?.metadata.title}
						</h1>
						<p class="article-abstract">
							{listening?.metadata.description}
						</p>
					</header>

					<div class="article-content">
						<slot>{listening?.content}</slot>
					</div>

					<ReadAloud
						locale={locale}
						t={t}
						articleSelector=".article-content"
					/>

					<footer class="footnotes" aria-label={t.ui.references}>
						<h2>{t.ui.references}</h2>
						<p style="font-size: var(--size-sm); color: var(--ink-muted); font-style: italic;">
							{locale === "nl"
								? "Dit luisterverhaal is onafhankelijk geauthored vanuit het canoniek feiten dossier. Geen URLs, citatie-tekenreeksen of audit-terminologie in de gesproken versie."
								: "This listening narrative is independently authored from the canonical fact dossier. No URLs, citation strings, or audit terminology in the spoken version."}
						</p>
						{hasRelatedVariants && (
							<p style="font-size: var(--size-sm); color: var(--ink-muted); margin-top: var(--space-3);">
								<strong>Derived from:</strong>{" "}
								{relatedVariants.map((v) => (
									<code style="margin: 0 var(--space-1); font-size: var(--size-xs);">
										{v.contentType} ({v.language}) -{" "}
										{v.artifactId}
									</code>
								))}
							</p>
						)}
					</footer>
				</article>
			</main>
		</div>

		<Footer locale={locale} t={t} />
		<CookieConsent locale={locale} t={t} />
	</body>
</html>
