---
import BaseHead from "../../../../components/BaseHead.astro";
import Footer from "../../../../components/Footer.astro";
import Masthead from "../../../../components/Masthead.astro";
import CookieConsent from "../../../../components/CookieConsent.astro";
import { getTranslation, type Locale } from "../../../../i18n";
import { withBase } from "../../../../i18n";
import {
	loadEditionContent,
	getEditionPaths,
	getEditionAlternateUrls,
	formatEditionDate,
	getReadingTime,
} from "../../../../lib/publication/astro-adapter.js";

export async function getStaticPaths() {
	const paths = await getEditionPaths();
	const result = [];

	for (const path of paths) {
		const edition = await loadEditionContent(path.props.editionDate);
		const publicArticles = edition?.englishArticles.filter(
			(a) =>
				a.metadata.lifecycleStatus === "VALIDATED" ||
				a.metadata.lifecycleStatus === "PUBLISHED",
		);
		if (publicArticles && publicArticles.length > 0) {
			result.push({
				params: {
					lang: path.params.lang,
					edition: path.params.edition,
				},
				props: {
					editionDate: path.props.editionDate,
					locale: path.props.locale,
				},
			});
		}
	}

	return result;
}

const { locale, editionDate } = Astro.props;
const t = getTranslation(locale);

const edition = await loadEditionContent(editionDate);

if (!edition) {
	return Astro.redirect(withBase(`/${locale}/404`));
}

const publicArticles = edition.englishArticles.filter(
	(a) =>
		a.metadata.lifecycleStatus === "VALIDATED" ||
		a.metadata.lifecycleStatus === "PUBLISHED",
);

if (publicArticles.length === 0) {
	return Astro.redirect(withBase(`/${locale}/404`));
}

const pageTitle = `${t.ui.latestEssays} — ${formatEditionDate(editionDate, locale)}`;
const pageDescription =
	locale === "nl"
		? `Engelse technische artikelen voor ${formatEditionDate(editionDate, locale)}`
		: `English technical articles for ${formatEditionDate(editionDate, locale)}`;

const canonicalURL = Astro.site
	? new URL(Astro.url.pathname, Astro.site)
	: new URL(Astro.url.pathname, "https://example.com");
const alternateUrls = getEditionAlternateUrls(
	editionDate,
	Astro.url.pathname,
	Astro.site,
);
---

<!doctype html>
<html lang={locale}>
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<link rel="canonical" href={canonicalURL} />
		{alternateUrls.map((alt) => (
			<link rel="alternate" hreflang={alt.lang} href={alt.url} />
		))}
		<link
			rel="alternate"
			hreflang="x-default"
			href={
				alternateUrls.find((a) => a.lang === "en")?.url ||
				`/en/edition/${editionDate}/articles/`
			}
		/>
	</head>
	<body>
		<a href="#main-content" class="skip-link">
			Skip to main content
		</a>
		<a href="#page-nav" class="skip-link">
			Skip to navigation
		</a>

		<Masthead currentPath={Astro.url.pathname} locale={locale} t={t} />

		<main
			class="reading-column"
			id="main-content"
			style="max-width: var(--measure); margin: 0 auto; padding: var(--space-6) var(--margin-page);"
		>
			<header style="margin-bottom: var(--space-7); padding-bottom: var(--space-5); border-bottom: 1px solid var(--mountain-light); text-align: center;">
				<h1 style="font-size: var(--size-3xl); margin-bottom: var(--space-3);">
					{pageTitle}
				</h1>
				<p style="font-size: var(--size-lg); color: var(--ink-muted); font-style: italic; max-width: 60ch; margin: 0 auto;">
					{pageDescription}
				</p>
			</header>

			<ul style="list-style: none; padding: 0; display: grid; gap: var(--space-4);">
				{publicArticles.map((article) => (
					<li style="border: 1px solid var(--mountain-light); border-radius: var(--radius); padding: var(--space-4); background: var(--sheet-darker);">
						<a
							href={withBase(
								`/${locale}/edition/${editionDate}/articles/${article.metadata.artifactId}/`,
							)}
							style="text-decoration: none; color: inherit; display: block;"
						>
							<h3 style="margin: 0 0 var(--space-2); font-size: var(--size-xl); color: var(--ink);">
								{article.metadata.title}
							</h3>
							<p style="color: var(--ink-muted); margin: 0 0 var(--space-2);">
								{article.metadata.description}
							</p>
							<div style="display: flex; flex-wrap: wrap; gap: var(--space-3); font-size: var(--size-sm); color: var(--ink-muted); font-family: var(--font-structural); align-items: center;">
								<span>
									📖 {getReadingTime(article)} min read
								</span>
								{article.metadata.topics.length > 0 && (
									<span style="color: var(--gold);">
										{article.metadata.topics
											.slice(0, 3)
											.join(", ")}
										{article.metadata.topics.length > 3
											? "…"
											: ""}
									</span>
								)}
								{article.metadata.organizations.length > 0 && (
									<span>
										{article.metadata.organizations
											.slice(0, 2)
											.join(", ")}
										{article.metadata.organizations.length >
										2
											? "…"
											: ""}
									</span>
								)}
							</div>
						</a>
					</li>
				))}
			</ul>

			<footer style="border-top: 1px solid var(--mountain-light); padding-top: var(--space-6); text-align: center; margin-top: var(--space-7);">
				<p style="max-width: 50ch; margin: 0 auto; color: var(--ink-muted); font-size: var(--size-sm);">
					{locale === "nl"
						? "Deze Engelse artikelen zijn derivaten van de canonieke Nederlandse publicatie. Feitelijke claims zijn traceerbaar naar bronnen via de originele publicatie."
						: "These English articles are derivatives of the canonical Dutch publication. Factual claims are traceable to sources via the original publication."}
				</p>
			</footer>
		</main>

		<Footer locale={locale} t={t} />
		<CookieConsent locale={locale} t={t} />
	</body>
</html>
