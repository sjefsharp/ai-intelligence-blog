{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-intelligence-blog/schemas/book-delta-knowledge-continuity.json",
  "title": "Book Delta Knowledge Continuity Result",
  "description": "Evidence for the Book Delta contribution to the Knowledge Continuity gate (K gate).",
  "type": "object",
  "properties": {
    "gateStatus": {
      "type": "string",
      "enum": ["PASS", "FAIL", "UNVERIFIED", "NOT_ASSESSABLE"]
    },
    "editionId": {
      "type": "string",
      "pattern": "^edition_\\d{4}-\\d{2}-\\d{2}$"
    },
    "editionDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "evaluationRan": {
      "type": "boolean"
    },
    "evidenceInspected": {
      "type": "boolean"
    },
    "candidatesEvaluated": {
      "type": "boolean"
    },
    "proposalsRecorded": {
      "type": "boolean"
    },
    "duplicatesHandled": {
      "type": "boolean"
    },
    "persistenceSucceeded": {
      "type": "boolean"
    },
    "readbackSucceeded": {
      "type": "boolean"
    },
    "limitationsReported": {
      "type": "boolean"
    },
    "unresolvedLimitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "details": {
      "type": "string",
      "minLength": 1
    },
    "evaluatedAt": {
      "type": "string"
    },
    "evaluatedBy": {
      "type": "string",
      "minLength": 1
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "gateStatus",
    "editionId",
    "editionDate",
    "evaluationRan",
    "evidenceInspected",
    "candidatesEvaluated",
    "proposalsRecorded",
    "duplicatesHandled",
    "persistenceSucceeded",
    "readbackSucceeded",
    "limitationsReported",
    "unresolvedLimitations",
    "details",
    "evaluatedAt",
    "evaluatedBy"
  ],
  "additionalProperties": false
}
