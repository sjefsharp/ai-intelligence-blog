    "acceptanceCriteria": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterionId": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "measurable": {
            "type": "boolean"
          },
          "verificationMethod": {
            "type": "string",
            "enum": [
              "content-inspection",
              "expert-review",
              "learner-feedback",
              "accessibility-audit",
              "technical-validation",
              "cross-reference-check"
            ]
          },
          "evidenceRequired": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "criterionId",
          "description",
          "measurable",
          "verificationMethod",
          "evidenceRequired"
        ],
        "additionalProperties": false
      }
    },
    "durability": {
      "type": "object",
      "properties": {
        "conceptualImportance": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "technicalAccuracy": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "reusability": {
          "type": "string",
          "enum": ["cross-domain", "domain-specific", "product-specific"]
