{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-intelligence-blog/schemas/daily-index.json",
  "title": "Daily Index",
  "description": "Navigational metadata for a daily edition, referencing the three canonical publications and their English derivatives. Not a fourth publication.",
  "type": "object",
  "properties": {
    "editionId": {
      "type": "string",
      "pattern": "^edition_\\d{4}-\\d{2}-\\d{2}$"
    },
    "editionDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "editionWindow": {
      "type": "object",
      "properties": {
        "editionDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "start": {
          "type": "string",
          "minLength": 1
        },
        "end": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "type": "string",
          "const": "Europe/Amsterdam"
        },
        "durationHours": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 25
        }
      },
      "required": ["editionDate", "start", "end", "timezone", "durationHours"],
      "additionalProperties": false
    },
    "reportingWindow": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "minLength": 1
        },
        "end": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "type": "string",
          "const": "Europe/Amsterdam"
        }
      },
      "required": ["start", "end", "timezone"],
      "additionalProperties": false
    },
    "canonicalPublications": {
      "minItems": 3,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "contentType": {
            "type": "string",
            "enum": ["newsletter", "research-audit", "listening-narrative"]
          },
          "language": {
            "type": "string",
            "const": "nl"
          },
          "artifactId": {
            "type": "string",
            "pattern": "^pubart_[a-z0-9]{16}$"
          },
          "filename": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "lifecycleStatus": {
            "type": "string",
            "enum": [
              "DRAFT",
              "READY_FOR_VALIDATION",
              "VALIDATED",
              "PUBLISHED",
              "FAILED",
              "INCOMPLETE",
              "SUPERSEDED"
            ]
          },
          "relativePath": {
            "type": "string",
            "minLength": 1
          },
          "readingTimeMinutes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "estimatedListeningDurationMinutes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "contentType",
          "language",
          "artifactId",
          "filename",
          "title",
          "description",
          "lifecycleStatus",
          "relativePath"
        ],
        "additionalProperties": false
      }
    },
    "englishDerivatives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "contentType": {
            "type": "string",
            "enum": ["english-derivative", "english-listening"]
          },
          "language": {
            "type": "string",
            "const": "en"
          },
          "artifactId": {
            "type": "string",
            "pattern": "^pubart_[a-z0-9]{16}$"
          },
          "filename": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "lifecycleStatus": {
            "type": "string",
            "enum": [
              "DRAFT",
              "READY_FOR_VALIDATION",
              "VALIDATED",
              "PUBLISHED",
              "FAILED",
              "INCOMPLETE",
              "SUPERSEDED"
            ]
          },
          "relativePath": {
            "type": "string",
            "minLength": 1
          },
          "sourceArtifactId": {
            "type": "string",
            "pattern": "^pubart_[a-z0-9]{16}$"
          }
        },
        "required": [
          "contentType",
          "language",
          "artifactId",
          "filename",
          "title",
          "description",
          "lifecycleStatus",
          "relativePath",
          "sourceArtifactId"
        ],
        "additionalProperties": false
      }
    },
    "availableNavigation": {
      "type": "object",
      "properties": {
        "byTopic": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "topic": {
                "type": "string"
              },
              "articleIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^art_[a-z0-9]{16}$"
                }
              }
            },
            "required": ["topic", "articleIds"],
            "additionalProperties": false
          }
        },
        "bySource": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "articleIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^art_[a-z0-9]{16}$"
                }
              }
            },
            "required": ["sourceId", "articleIds"],
            "additionalProperties": false
          }
        },
        "byOrganization": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "organization": {
                "type": "string"
              },
              "articleIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^art_[a-z0-9]{16}$"
                }
              }
            },
            "required": ["organization", "articleIds"],
            "additionalProperties": false
          }
        },
        "byResearchDomain": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "domain": {
                "type": "string"
              },
              "articleIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^art_[a-z0-9]{16}$"
                }
              }
            },
            "required": ["domain", "articleIds"],
            "additionalProperties": false
          }
        }
      },
      "required": ["byTopic", "bySource", "byOrganization", "byResearchDomain"],
      "additionalProperties": false
    },
    "missingArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "contentType": {
            "type": "string",
            "enum": [
              "newsletter",
              "research-audit",
              "listening-narrative",
              "daily-index",
              "english-derivative",
              "english-listening"
            ]
          },
          "language": {
            "type": "string",
            "enum": ["nl", "en"]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": ["contentType", "language", "reason"],
        "additionalProperties": false
      }
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "generatedBy": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "editionId",
    "editionDate",
    "editionWindow",
    "reportingWindow",
    "canonicalPublications",
    "availableNavigation",
    "missingArtifacts",
    "generatedAt",
    "generatedBy",
    "schemaVersion"
  ],
  "additionalProperties": false
}
