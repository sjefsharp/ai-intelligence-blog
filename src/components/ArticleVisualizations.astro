---
/**
 * ArticleVisualizations.astro
 *
 * Loads and renders all visualizations associated with an article.
 * Consumes visualization specifications from the edition's visualization directory.
 */

import type { VisualizationSpecification } from "../lib/visualization/schema.js";
import { promises as fs } from "node:fs";
import { join } from "node:path";
import { fileURLToPath } from "node:url";
import Visualization from "./Visualization.astro";

interface Props {
	/** Article ID to load visualizations for */
	articleId: string;
	/** Edition date (YYYY-MM-DD) */
	editionDate: string;
	/** Current locale */
	locale: "nl" | "en";
	/** Data directory root */
	dataDir?: string;
}

const { articleId, editionDate, locale, dataDir = "data" } = Astro.props;

const __filename = fileURLToPath(import.meta.url);
const __dirname = join(__filename, "..", "..", "..");
const PROJECT_ROOT = join(__dirname, "..");
const VISUALIZATION_DIR = join(
	PROJECT_ROOT,
	dataDir,
	"visualizations",
	`edition_${editionDate}`,
);

let visualizations: VisualizationSpecification[] = [];

try {
	const files = await fs.readdir(VISUALIZATION_DIR);
	const specFiles = files.filter(
		(f) => f.endsWith(".json") && f.startsWith("viz_"),
	);

	for (const file of specFiles) {
		const content = await fs.readFile(
			join(VISUALIZATION_DIR, file),
			"utf-8",
		);
		const spec = JSON.parse(content) as VisualizationSpecification;

		// Filter visualizations for this article
		if (spec.articleId === articleId || spec.articleId === undefined) {
			// If no articleId specified, include if any candidate matches article's candidates
			// For now, include all visualizations for the edition
			visualizations.push(spec);
		}
	}
} catch {
	// No visualizations directory or no files — visualizations are optional
	visualizations = [];
}
---

<!--
  Article Visualizations
  Renders all evidence-based visual explanations associated with an article.
  Visualizations are optional — their absence never blocks publication.
-->
{visualizations.length > 0 && (
	<section
		class="article-visualizations"
		aria-labelledby="visualizations-heading"
	>
		<h2 id="visualizations-heading" class="visualizations-section-title">
			{locale === "nl" ? "Visuele uitleg" : "Visual explanations"}
		</h2>

		<ul class="visualizations-list" role="list">
			{visualizations.map((spec) => (
				<li class="visualization-list-item">
					<Visualization spec={spec} locale={locale} />
				</li>
			))}
		</ul>
	</section>
)}

<style>
	.article-visualizations {
		margin: var(--space-7) 0 var(--space-5);
		padding-top: var(--space-5);
		border-top: 1px solid var(--mountain-light);
	}

	.visualizations-section-title {
		font-family: var(--font-display);
		font-size: var(--size-xl);
		font-weight: 700;
		color: var(--ink);
		margin: 0 0 var(--space-5);
		padding-bottom: var(--space-3);
		border-bottom: 1px solid var(--mountain-light);
	}

	.visualizations-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
	}

	.visualization-list-item {
		/* Visualization.astro handles its own spacing */
	}

	@media (max-width: 720px) {
		.article-visualizations {
			margin-left: calc(var(--margin-page) * -1);
			margin-right: calc(var(--margin-page) * -1);
			padding-left: var(--margin-page);
			padding-right: var(--margin-page);
		}
	}
</style>
