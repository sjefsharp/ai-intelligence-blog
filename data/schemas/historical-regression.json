{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-intelligence-blog/schemas/historical-regression.json",
  "title": "Historical Regression Report",
  "description": "Structured findings from the rolling seven-calendar-day historical regression stage. Compares the current canonical fact dossier against accessible previous editions and their supporting evidence without redefining the strict daily news eligibility window and without modifying previously published editions.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "reportId": {
      "type": "string",
      "pattern": "^hr_[a-z0-9]{16}$"
    },
    "editionId": {
      "type": "string",
      "pattern": "^edition_\\d{4}-\\d{2}-\\d{2}$"
    },
    "editionDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "editionWindow": {
      "type": "object",
      "properties": {
        "editionDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "start": {
          "type": "string",
          "minLength": 1
        },
        "end": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "type": "string",
          "const": "Europe/Amsterdam"
        },
        "durationHours": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["editionDate", "start", "end", "timezone", "durationHours"],
      "additionalProperties": false
    },
    "executionId": {
      "type": "string",
      "minLength": 1
    },
    "executedAt": {
      "type": "string",
      "minLength": 1
    },
    "generatedBy": {
      "type": "string",
      "minLength": 1
    },
    "currentDossierVersion": {
      "type": "string",
      "minLength": 1
    },
    "currentDossierContentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "historicalWindow": {
      "type": "object",
      "properties": {
        "days": {
          "type": "number",
          "const": 7
        },
        "timezone": {
          "type": "string",
          "const": "Europe/Amsterdam"
        },
        "editionDates": {
          "minItems": 7,
          "maxItems": 7,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "dailyEligibilityWindow": {
          "type": "object",
          "properties": {
            "editionDate": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "start": {
              "type": "string",
              "minLength": 1
            },
            "end": {
              "type": "string",
              "minLength": 1
            },
            "timezone": {
              "type": "string",
              "const": "Europe/Amsterdam"
            },
            "durationHours": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "editionDate",
            "start",
            "end",
            "timezone",
            "durationHours"
          ],
          "additionalProperties": false
        },
        "dailyEligibilityWindowUnchanged": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "days",
        "timezone",
        "editionDates",
        "dailyEligibilityWindow",
        "dailyEligibilityWindowUnchanged"
      ],
      "additionalProperties": false
    },
    "historicalEditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "editionDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "editionId": {
            "type": "string",
            "pattern": "^edition_\\d{4}-\\d{2}-\\d{2}$"
          },
          "exists": {
            "type": "boolean"
          },
          "dossierAvailable": {
            "type": "boolean"
          },
          "dossierValid": {
            "type": "boolean"
          },
          "researchAuditAvailable": {
            "type": "boolean"
          },
          "researchAuditValid": {
            "type": "boolean"
          },
          "publishedArticleRecordsAvailable": {
            "type": "boolean"
          },
          "candidateRecordsAvailable": {
            "type": "boolean"
          },
          "discoveryRecordsAvailable": {
            "type": "boolean"
          },
          "monitoringRecordsAvailable": {
            "type": "boolean"
          },
          "candidateIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "claimIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "publicationIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "canBeReliablyCompared": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": ["AVAILABLE", "PARTIAL", "UNAVAILABLE", "NOT_ASSESSABLE"]
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "editionDate",
          "editionId",
          "exists",
          "dossierAvailable",
          "dossierValid",
          "researchAuditAvailable",
          "researchAuditValid",
          "publishedArticleRecordsAvailable",
          "candidateRecordsAvailable",
          "discoveryRecordsAvailable",
          "monitoringRecordsAvailable",
          "candidateIds",
          "claimIds",
          "sourceIds",
          "publicationIds",
          "canBeReliablyCompared",
          "status",
          "missing",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "candidatesEvaluated": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidateId": {
            "type": "string"
          },
          "editionDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "classification": {
            "type": "string",
            "enum": [
              "NEW_DEVELOPMENT",
              "PREVIOUSLY_COVERED",
              "SUBSTANTIVE_UPDATE",
              "REPEATED_REPORTING",
              "RELATED_CONTEXT",
              "POTENTIAL_HISTORICAL_OMISSION",
              "HISTORY_UNVERIFIED"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "matches": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "editionDate": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "editionId": {
                  "type": "string",
                  "pattern": "^edition_\\d{4}-\\d{2}-\\d{2}$"
                },
                "matched": {
                  "type": "boolean"
                },
                "matchType": {
                  "type": "string",
                  "enum": [
                    "candidate-id",
                    "claim-id",
                    "source-url",
                    "source-id",
                    "entity",
                    "timestamp",
                    "semantic-similarity",
                    "none"
                  ]
                },
                "matchedCandidateIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "matchedClaimIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "matchedSourceIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "semanticMatchCandidateId": {
                  "type": "string"
                },
                "matchedUrls": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "sharedOrganizations": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "sharedProducts": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "sharedTechnologies": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "sharedResearchDomains": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "headlineSimilarity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "claimSimilarity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "timestampMatch": {
                  "type": "boolean"
                },
                "previousPublicationId": {
                  "type": "string"
                },
                "evidenceReferences": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "editionDate",
                "editionId",
                "matched",
                "matchType",
                "matchedCandidateIds",
                "matchedClaimIds",
                "matchedSourceIds",
                "matchedUrls",
                "sharedOrganizations",
                "sharedProducts",
                "sharedTechnologies",
                "sharedResearchDomains",
                "headlineSimilarity",
                "claimSimilarity",
                "timestampMatch",
                "evidenceReferences",
                "note"
              ],
              "additionalProperties": false
            }
          },
          "primaryMatchEditionDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "primaryMatchCandidateId": {
            "type": "string"
          },
          "primaryMatchType": {
            "type": "string",
            "enum": [
              "candidate-id",
              "claim-id",
              "source-url",
              "source-id",
              "entity",
              "timestamp",
              "semantic-similarity",
              "none"
            ]
          },
          "substantiveUpdate": {
            "type": "object",
            "properties": {
              "updateTypes": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "availability-change",
                    "benchmark-change",
                    "independent-replication",
                    "security-incident",
                    "behavior-change",
                    "licensing-pricing-availability",
                    "technical-limitation",
                    "original-reporting",
                    "follow-up-research",
                    "strategic-research-revision",
                    "measured-outcome",
                    "methodology-change"
                  ]
                }
              },
              "previousEditionDate": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "previousEditionId": {
                "type": "string",
                "pattern": "^edition_\\d{4}-\\d{2}-\\d{2}$"
              },
              "previousCandidateId": {
                "type": "string"
              },
              "previousClaimIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "currentClaimIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "changedFacts": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "evidenceUrls": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "newInformationTimestamp": {
                "type": "string"
              },
              "withinCurrentEditionWindow": {
                "type": "boolean"
              },
              "rationale": {
                "type": "string"
              }
            },
            "required": [
              "updateTypes",
              "previousEditionDate",
              "previousEditionId",
              "previousCandidateId",
              "previousClaimIds",
              "currentClaimIds",
              "changedFacts",
              "evidenceUrls",
              "newInformationTimestamp",
              "withinCurrentEditionWindow",
              "rationale"
            ],
            "additionalProperties": false
          },
          "repeatedReporting": {
            "type": "object",
            "properties": {
              "previousEditionDate": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "previousEditionId": {
                "type": "string",
                "pattern": "^edition_\\d{4}-\\d{2}-\\d{2}$"
              },
              "previousCandidateId": {
                "type": "string"
              },
              "previousClaimIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "repeatedClaimIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "qualifyingChange": {
                "type": "null",
                "const": null
              },
              "evidenceUrls": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rationale": {
                "type": "string"
              }
            },
            "required": [
              "previousEditionDate",
              "previousEditionId",
              "previousCandidateId",
              "previousClaimIds",
              "repeatedClaimIds",
              "qualifyingChange",
              "evidenceUrls",
              "rationale"
            ],
            "additionalProperties": false
          },
          "historicalContext": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rationale": {
            "type": "string"
          },
          "derivedFrom": {
            "type": "string",
            "enum": [
              "deterministic-matching",
              "semantic-comparison",
              "history-unavailable"
            ]
          },
          "semanticComparisonUsed": {
            "type": "boolean"
          }
        },
        "required": [
          "candidateId",
          "editionDate",
          "classification",
          "confidence",
          "matches",
          "historicalContext",
          "rationale",
          "derivedFrom",
          "semanticComparisonUsed"
        ],
        "additionalProperties": false
      }
    },
    "substantiveUpdates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "updateTypes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "availability-change",
                "benchmark-change",
                "independent-replication",
                "security-incident",
                "behavior-change",
                "licensing-pricing-availability",
                "technical-limitation",
                "original-reporting",
                "follow-up-research",
                "strategic-research-revision",
                "measured-outcome",
                "methodology-change"
              ]
            }
          },
          "previousEditionDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "previousEditionId": {
            "type": "string",
            "pattern": "^edition_\\d{4}-\\d{2}-\\d{2}$"
          },
          "previousCandidateId": {
            "type": "string"
          },
          "previousClaimIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "currentClaimIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "changedFacts": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidenceUrls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "newInformationTimestamp": {
            "type": "string"
          },
          "withinCurrentEditionWindow": {
            "type": "boolean"
          },
          "rationale": {
            "type": "string"
          }
        },
        "required": [
          "updateTypes",
          "previousEditionDate",
          "previousEditionId",
          "previousCandidateId",
          "previousClaimIds",
          "currentClaimIds",
          "changedFacts",
          "evidenceUrls",
          "newInformationTimestamp",
          "withinCurrentEditionWindow",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "repeatedReporting": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "previousEditionDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "previousEditionId": {
            "type": "string",
            "pattern": "^edition_\\d{4}-\\d{2}-\\d{2}$"
          },
          "previousCandidateId": {
            "type": "string"
          },
          "previousClaimIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "repeatedClaimIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "qualifyingChange": {
            "type": "null",
            "const": null
          },
          "evidenceUrls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rationale": {
            "type": "string"
          }
        },
        "required": [
          "previousEditionDate",
          "previousEditionId",
          "previousCandidateId",
          "previousClaimIds",
          "repeatedClaimIds",
          "qualifyingChange",
          "evidenceUrls",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "potentialOmissions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidateId": {
            "type": "string"
          },
          "suspectedMissedEditionDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "suspectedMissedEditionId": {
            "type": "string",
            "pattern": "^edition_\\d{4}-\\d{2}-\\d{2}$"
          },
          "firstDisclosureTimestamp": {
            "type": "string"
          },
          "classification": {
            "type": "string",
            "enum": [
              "ALREADY_COVERED_ELSEWHERE",
              "PREVIOUSLY_DISCOVERED_NOT_SELECTED",
              "PREVIOUSLY_INACCESSIBLE",
              "NOT_DISCOVERED",
              "INSUFFICIENT_EVIDENCE",
              "NOT_ASSESSABLE"
            ]
          },
          "significance": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "rationale": {
            "type": "string"
          },
          "evidenceUrls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "proposedCatchUp": {
            "type": "boolean"
          },
          "catchUpNote": {
            "type": "string"
          }
        },
        "required": [
          "candidateId",
          "suspectedMissedEditionDate",
          "suspectedMissedEditionId",
          "firstDisclosureTimestamp",
          "classification",
          "significance",
          "rationale",
          "evidenceUrls",
          "proposedCatchUp"
        ],
        "additionalProperties": false
      }
    },
    "missingHistoricalEvidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolvedQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "finalStatus": {
      "type": "string",
      "enum": ["COMPLETE", "PARTIAL", "UNAVAILABLE", "NOT_ASSESSABLE"]
    },
    "inferenceUsed": {
      "type": "boolean"
    },
    "inferenceNote": {
      "type": "string"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
