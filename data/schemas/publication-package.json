{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-intelligence-blog/schemas/publication-package.json",
  "title": "Publication Package",
  "description": "Complete daily publication package containing three canonical UTF-8 Markdown publications, daily index, English derivatives, and validation metadata. All artifacts derive from the canonical fact dossier and editorial selection manifest without introducing competing factual inventories.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "packageId": {
      "type": "string",
      "pattern": "^pubpkg_[a-z0-9]{16}$"
    },
    "editionIdentity": {
      "type": "object",
      "properties": {
        "editionId": {
          "type": "string",
          "pattern": "^edition_\\d{4}-\\d{2}-\\d{2}$"
        },
        "editionDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "editionWindow": {
          "type": "object",
          "properties": {
            "editionDate": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "start": {
              "type": "string",
              "minLength": 1
            },
            "end": {
              "type": "string",
              "minLength": 1
            },
            "timezone": {
              "type": "string",
              "const": "Europe/Amsterdam"
            },
            "durationHours": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 25
            }
          },
          "required": [
            "editionDate",
            "start",
            "end",
            "timezone",
            "durationHours"
          ],
          "additionalProperties": false
        },
        "reportingWindow": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string",
              "minLength": 1
            },
            "end": {
              "type": "string",
              "minLength": 1
            },
            "timezone": {
              "type": "string",
              "const": "Europe/Amsterdam"
            }
          },
          "required": ["start", "end", "timezone"],
          "additionalProperties": false
        }
      },
      "required": [
        "editionId",
        "editionDate",
        "editionWindow",
        "reportingWindow"
      ],
      "additionalProperties": false
    },
    "canonicalReferences": {
      "type": "object",
      "properties": {
        "factDossier": {
          "type": "object",
          "properties": {
            "dossierId": {
              "type": "string",
              "pattern": "^fd_[a-z0-9]{16}$"
            },
            "editionId": {
              "type": "string",
              "pattern": "^edition_\\d{4}-\\d{2}-\\d{2}$"
            },
            "contentHash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": ["dossierId", "editionId", "contentHash"],
          "additionalProperties": false
        },
        "editorialSelection": {
          "type": "object",
          "properties": {
            "manifestId": {
              "type": "string",
              "pattern": "^esm_[a-z0-9]{16}$"
            },
            "editionId": {
              "type": "string",
              "pattern": "^edition_\\d{4}-\\d{2}-\\d{2}$"
            },
            "contentHash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": ["manifestId", "editionId", "contentHash"],
          "additionalProperties": false
        },
        "historicalRegression": {
          "type": "object",
          "properties": {
            "reportId": {
              "type": "string",
              "pattern": "^hr_[a-z0-9]{16}$"
            },
            "editionId": {
              "type": "string",
              "pattern": "^edition_\\d{4}-\\d{2}-\\d{2}$"
            },
            "contentHash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "referenced": {
              "type": "boolean"
            }
          },
          "required": ["reportId", "editionId", "contentHash", "referenced"],
          "additionalProperties": false
        },
        "omissionReview": {
          "type": "object",
          "properties": {
            "reportId": {
              "type": "string",
              "minLength": 1
            },
            "executionId": {
              "type": "string",
              "minLength": 1
            },
            "referenced": {
              "type": "boolean"
            }
          },
          "required": ["reportId", "executionId", "referenced"],
          "additionalProperties": false
        }
      },
      "required": [
        "factDossier",
        "editorialSelection",
        "historicalRegression",
        "omissionReview"
      ],
      "additionalProperties": false
    },
    "articles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "articleId": {
            "type": "string",
            "pattern": "^art_[a-z0-9]{16}$"
          },
          "storyId": {
            "type": "string",
            "pattern": "^story_[a-z0-9]{16}$"
          },
          "candidateIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^cand_[a-z0-9]{16}$"
            }
          },
          "claimIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^claim_[a-z0-9]{16}$"
            }
          },
          "sourceIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          },
          "sourceReferences": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "organizations": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "researchDomains": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "discoveryRings": {
            "minItems": 1,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "number",
                  "const": 1
                },
                {
                  "type": "number",
                  "const": 2
                },
                {
                  "type": "number",
                  "const": 3
                }
              ]
            }
          },
          "materialityScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "materialityLevel": {
            "type": "string",
            "enum": ["high", "medium", "low", "unclear"]
          },
          "recommendedDepth": {
            "type": "string",
            "enum": ["brief", "standard", "deep-dive"]
          },
          "explanationOpportunities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "technical-deep-dive",
                "scientific-explanation",
                "strategic-interpretation",
                "accessible-comparison",
                "diagram",
                "timeline",
                "historical-context",
                "practical-engineering"
              ]
            }
          },
          "evidenceClassificationSummary": {
            "type": "string",
            "minLength": 1
          },
          "caveats": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "articleId",
          "storyId",
          "candidateIds",
          "claimIds",
          "sourceIds",
          "sourceReferences",
          "organizations",
          "researchDomains",
          "discoveryRings",
          "materialityScore",
          "materialityLevel",
          "recommendedDepth",
          "explanationOpportunities",
          "evidenceClassificationSummary",
          "caveats"
        ],
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifactId": {
            "type": "string",
            "pattern": "^pubart_[a-z0-9]{16}$"
          },
          "editionId": {
            "type": "string",
            "pattern": "^edition_\\d{4}-\\d{2}-\\d{2}$"
          },
          "editionDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "contentType": {
            "type": "string",
            "enum": [
              "newsletter",
              "research-audit",
              "listening-narrative",
              "daily-index",
              "english-derivative",
              "english-listening"
            ]
          },
          "language": {
            "type": "string",
            "enum": ["nl", "en"]
          },
          "canonicalFilename": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "articleId": {
            "type": "string",
            "pattern": "^art_[a-z0-9]{16}$"
          },
          "publicationTimestamp": {
            "type": "string",
            "minLength": 1
          },
          "originalNewsDisclosureTimestamp": {
            "type": "string"
          },
          "lastSubstantiveUpdateTimestamp": {
            "type": "string"
          },
          "readingTimeMinutes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "estimatedListeningDurationMinutes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "sourceReferences": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "claimReferences": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^claim_[a-z0-9]{16}$"
            }
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "organizations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lifecycleStatus": {
            "type": "string",
            "enum": [
              "DRAFT",
              "READY_FOR_VALIDATION",
              "VALIDATED",
              "PUBLISHED",
              "FAILED",
              "INCOMPLETE",
              "SUPERSEDED"
            ]
          },
          "validationStatus": {
            "type": "string",
            "enum": ["pending", "passed", "failed", "skipped"]
          },
          "validationResults": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "gate": {
                  "type": "string"
                },
                "passed": {
                  "type": "boolean"
                },
                "details": {
                  "type": "string"
                },
                "timestamp": {
                  "type": "string"
                }
              },
              "required": ["gate", "passed", "timestamp"],
              "additionalProperties": false
            }
          },
          "relatedVariants": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "contentType": {
                  "type": "string",
                  "enum": [
                    "newsletter",
                    "research-audit",
                    "listening-narrative",
                    "daily-index",
                    "english-derivative",
                    "english-listening"
                  ]
                },
                "language": {
                  "type": "string",
                  "enum": ["nl", "en"]
                },
                "artifactId": {
                  "type": "string",
                  "pattern": "^pubart_[a-z0-9]{16}$"
                },
                "relationship": {
                  "type": "string",
                  "enum": [
                    "translation",
                    "derivative",
                    "source",
                    "listening-text"
                  ]
                }
              },
              "required": [
                "contentType",
                "language",
                "artifactId",
                "relationship"
              ],
              "additionalProperties": false
            }
          },
          "version": {
            "default": 1,
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "schemaVersion": {
            "type": "string",
            "const": "1.0.0"
          },
          "contentHash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "artifactId",
          "editionId",
          "editionDate",
          "contentType",
          "language",
          "canonicalFilename",
          "title",
          "description",
          "publicationTimestamp",
          "sourceReferences",
          "claimReferences",
          "topics",
          "organizations",
          "lifecycleStatus",
          "validationStatus",
          "validationResults",
          "relatedVariants",
          "version",
          "schemaVersion"
        ],
        "additionalProperties": false
      }
    },
    "dailyIndex": {
      "type": "object",
      "properties": {
        "editionId": {
          "type": "string",
          "pattern": "^edition_\\d{4}-\\d{2}-\\d{2}$"
        },
        "editionDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "editionWindow": {
          "type": "object",
          "properties": {
            "editionDate": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "start": {
              "type": "string",
              "minLength": 1
            },
            "end": {
              "type": "string",
              "minLength": 1
            },
            "timezone": {
              "type": "string",
              "const": "Europe/Amsterdam"
            },
            "durationHours": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 25
            }
          },
          "required": [
            "editionDate",
            "start",
            "end",
            "timezone",
            "durationHours"
          ],
          "additionalProperties": false
        },
        "reportingWindow": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string",
              "minLength": 1
            },
            "end": {
              "type": "string",
              "minLength": 1
            },
            "timezone": {
              "type": "string",
              "const": "Europe/Amsterdam"
            }
          },
          "required": ["start", "end", "timezone"],
          "additionalProperties": false
        },
        "canonicalPublications": {
          "minItems": 3,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "contentType": {
                "type": "string",
                "enum": ["newsletter", "research-audit", "listening-narrative"]
              },
              "language": {
                "type": "string",
                "const": "nl"
              },
              "artifactId": {
                "type": "string",
                "pattern": "^pubart_[a-z0-9]{16}$"
              },
              "filename": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "lifecycleStatus": {
                "type": "string",
                "enum": [
                  "DRAFT",
                  "READY_FOR_VALIDATION",
                  "VALIDATED",
                  "PUBLISHED",
                  "FAILED",
                  "INCOMPLETE",
                  "SUPERSEDED"
                ]
              },
              "relativePath": {
                "type": "string",
                "minLength": 1
              },
              "readingTimeMinutes": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "estimatedListeningDurationMinutes": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "contentType",
              "language",
              "artifactId",
              "filename",
              "title",
              "description",
              "lifecycleStatus",
              "relativePath"
            ],
            "additionalProperties": false
          }
        },
        "englishDerivatives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "contentType": {
                "type": "string",
                "enum": ["english-derivative", "english-listening"]
              },
              "language": {
                "type": "string",
                "const": "en"
              },
              "artifactId": {
                "type": "string",
                "pattern": "^pubart_[a-z0-9]{16}$"
              },
              "filename": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "lifecycleStatus": {
                "type": "string",
                "enum": [
                  "DRAFT",
                  "READY_FOR_VALIDATION",
                  "VALIDATED",
                  "PUBLISHED",
                  "FAILED",
                  "INCOMPLETE",
                  "SUPERSEDED"
                ]
              },
              "relativePath": {
                "type": "string",
                "minLength": 1
              },
              "sourceArtifactId": {
                "type": "string",
                "pattern": "^pubart_[a-z0-9]{16}$"
              }
            },
            "required": [
              "contentType",
              "language",
              "artifactId",
              "filename",
              "title",
              "description",
              "lifecycleStatus",
              "relativePath",
              "sourceArtifactId"
            ],
            "additionalProperties": false
          }
        },
        "availableNavigation": {
          "type": "object",
          "properties": {
            "byTopic": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "topic": {
                    "type": "string"
                  },
                  "articleIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^art_[a-z0-9]{16}$"
                    }
                  }
                },
                "required": ["topic", "articleIds"],
                "additionalProperties": false
              }
            },
            "bySource": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sourceId": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]+$"
                  },
                  "articleIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^art_[a-z0-9]{16}$"
                    }
                  }
                },
                "required": ["sourceId", "articleIds"],
                "additionalProperties": false
              }
            },
            "byOrganization": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "organization": {
                    "type": "string"
                  },
                  "articleIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^art_[a-z0-9]{16}$"
                    }
                  }
                },
                "required": ["organization", "articleIds"],
                "additionalProperties": false
              }
            },
            "byResearchDomain": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "domain": {
                    "type": "string"
                  },
                  "articleIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^art_[a-z0-9]{16}$"
                    }
                  }
                },
                "required": ["domain", "articleIds"],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "byTopic",
            "bySource",
            "byOrganization",
            "byResearchDomain"
          ],
          "additionalProperties": false
        },
        "missingArtifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "contentType": {
                "type": "string",
                "enum": [
                  "newsletter",
                  "research-audit",
                  "listening-narrative",
                  "daily-index",
                  "english-derivative",
                  "english-listening"
                ]
              },
              "language": {
                "type": "string",
                "enum": ["nl", "en"]
              },
              "reason": {
                "type": "string"
              }
            },
            "required": ["contentType", "language", "reason"],
            "additionalProperties": false
          }
        },
        "generatedAt": {
          "type": "string",
          "minLength": 1
        },
        "generatedBy": {
          "type": "string",
          "minLength": 1
        },
        "schemaVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "editionId",
        "editionDate",
        "editionWindow",
        "reportingWindow",
        "canonicalPublications",
        "availableNavigation",
        "missingArtifacts",
        "generatedAt",
        "generatedBy",
        "schemaVersion"
      ],
      "additionalProperties": false
    },
    "validationSummary": {
      "type": "object",
      "properties": {
        "totalArtifacts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "validatedArtifacts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failedArtifacts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "incompleteArtifacts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "allGatesPassed": {
          "type": "boolean"
        },
        "validationTimestamp": {
          "type": "string"
        }
      },
      "required": [
        "totalArtifacts",
        "validatedArtifacts",
        "failedArtifacts",
        "incompleteArtifacts",
        "allGatesPassed",
        "validationTimestamp"
      ],
      "additionalProperties": false
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "generatedBy": {
      "type": "string",
      "minLength": 1
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "packageId",
    "editionIdentity",
    "canonicalReferences",
    "articles",
    "artifacts",
    "dailyIndex",
    "validationSummary",
    "generatedAt",
    "generatedBy",
    "contentHash"
  ],
  "additionalProperties": false
}
